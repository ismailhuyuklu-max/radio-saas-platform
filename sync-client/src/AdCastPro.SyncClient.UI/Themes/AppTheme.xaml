<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:conv="clr-namespace:AdCastPro.SyncClient.UI.Converters">

    <!-- ===== Renk paleti (ekteki tasarimla birebir) ===== -->
    <SolidColorBrush x:Key="BrandRed" Color="#E11D48" />
    <SolidColorBrush x:Key="BrandRedDark" Color="#9F1239" />
    <SolidColorBrush x:Key="BgDark" Color="#07101E" />
    <SolidColorBrush x:Key="BgSidebar" Color="#070C16" />
    <SolidColorBrush x:Key="BgCard" Color="#0E1728" />
    <SolidColorBrush x:Key="BgCardAlt" Color="#121F34" />
    <SolidColorBrush x:Key="FgPrimary" Color="#F8FAFC" />
    <SolidColorBrush x:Key="FgMuted" Color="#94A3B8" />
    <SolidColorBrush x:Key="FgDim" Color="#64748B" />
    <SolidColorBrush x:Key="BorderColor" Color="#22314A" />
    <SolidColorBrush x:Key="StatusGreen" Color="#19C37D" />
    <SolidColorBrush x:Key="StatusYellow" Color="#F59E0B" />
    <SolidColorBrush x:Key="StatusRed" Color="#EF4444" />
    <SolidColorBrush x:Key="TrackColor" Color="#1B2638" />
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>

    <LinearGradientBrush x:Key="AppSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#08111F" Offset="0" />
        <GradientStop Color="#0B1425" Offset="0.55" />
        <GradientStop Color="#070C16" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardPremiumBrush" StartPoint="0,0" EndPoint="0.85,1">
        <GradientStop Color="#142239" Offset="0" />
        <GradientStop Color="#0D1728" Offset="0.48" />
        <GradientStop Color="#091120" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardPremiumBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#344866" Offset="0" />
        <GradientStop Color="#1C2B43" Offset="0.46" />
        <GradientStop Color="#3A1A2A" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SuccessBannerBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#21C78A" Offset="0" />
        <GradientStop Color="#13A86E" Offset="1" />
    </LinearGradientBrush>

    <!-- ===== Converters ===== -->
    <conv:SectionToVisibilityConverter x:Key="SectionToVis" />
    <conv:LucideKindConverter x:Key="LucideKind" />
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- ===== Kaydirma cubugu (tema renkleriyle uyumlu) ===== -->
    <SolidColorBrush x:Key="ScrollThumb" Color="#2A3A55" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#3B4F70" />

    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Background="{StaticResource ScrollThumb}" CornerRadius="4" Margin="2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ScrollThumbHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandRed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="Height" Value="10" />
                            <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Kart cercevesi ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardPremiumBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardPremiumBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000814" BlurRadius="22" ShadowDepth="0" Opacity="0.45" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PanelCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="InnerPanel" TargetType="Border">
        <Setter Property="Background" Value="#0A1323" />
        <Setter Property="BorderBrush" Value="#1E2D45" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- ===== Tipografi ===== -->
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="15.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource FgPrimary}" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <!-- Kart başlığı metni (ikon yanında kullanılır, alt boşluk StackPanel'de). -->
    <Style x:Key="CardTitleInline" TargetType="TextBlock" BasedOn="{StaticResource CardTitle}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <!-- Kart başlığı ikonu: temiz Lucide line-icon, ortak boyut/renk. -->
    <Style x:Key="CardHeaderIcon" TargetType="iconPacks:PackIconLucide">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Foreground" Value="{StaticResource StatusGreen}" />
    </Style>

    <!-- Mini metrik/satır ikonu (Servis kartları, key-value satırları). -->
    <Style x:Key="MetricIcon" TargetType="iconPacks:PackIconLucide">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource FgMuted}" />
    </Style>
    <Style x:Key="SectionEyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource FgDim}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource FgMuted}" />
    </Style>
    <Style x:Key="ValueText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource FgPrimary}" />
    </Style>

    <Style x:Key="MetricLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="StatusBadgeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Sidebar nav item (RadioButton) ===== -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource FgMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="10,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="accent" Width="3.5" Height="17" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{StaticResource BrandRed}" Visibility="Collapsed">
                            <Border.Effect><DropShadowEffect Color="#E11D48" BlurRadius="8" ShadowDepth="0" Opacity="0.8" /></Border.Effect>
                        </Border>
                        <Border x:Name="b" CornerRadius="10" Padding="14,6" Margin="8,0,0,0" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconLucide Grid.Column="0" Width="17" Height="17" VerticalAlignment="Center"
                                           Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LucideKind}}"
                                           Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#16213A" />
                            <Setter Property="Foreground" Value="{StaticResource FgPrimary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#33121E" />
                            <Setter TargetName="accent" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource FgPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Butonlar ===== -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource FgPrimary}" />
        <Setter Property="Background" Value="#111D31" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="9" Background="{TemplateBinding Background}"
                            BorderBrush="#2A3D5B" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#172844" />
                            <Setter TargetName="b" Property="BorderBrush" Value="#4B6D9C" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pencere kapatma butonu (cerceveyesiz pencereler icin) -->
    <Style x:Key="WindowCloseButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource FgMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="0,13,0,13">
                        <TextBlock x:Name="t" Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource BrandRed}" />
                            <Setter TargetName="t" Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Background" Value="{StaticResource BrandRed}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="9" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#F43F5E" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MeterBar: CPU/RAM/Disk gibi yüzde metrikleri için ince, yuvarlatılmış,
         dolum rengini Foreground'dan alan premium mini gösterge çubuğu. -->
    <Style x:Key="MeterBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="7" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Background" Value="#0B1422" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource StatusGreen}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="4" Background="{TemplateBinding Background}"
                            BorderBrush="#1A2941" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" CornerRadius="4" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Klasör seçme (Gözat) butonu: Lucide klasör ikonu (ortak). -->
    <Style x:Key="IconBrowseButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <iconPacks:PackIconLucide Kind="FolderOpen" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToggleSwitch: premium açık/kapalı anahtarı (otomatik güncelleme vb.). -->
    <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="track" CornerRadius="12" Background="#16243A" BorderBrush="#26344C" BorderThickness="1">
                        <Ellipse x:Name="thumb" Width="18" Height="18" Fill="#94A3B8"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource StatusGreen}" />
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource StatusGreen}" />
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0" />
                            <Setter TargetName="thumb" Property="Fill" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
