<Window
    x:Class="AdCastPro.SyncClient.UI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:AdCastPro.SyncClient.UI.Controls"
    Title="AdCast Pro Senkronizasyon İstemcisi"
    Icon="/AdCastPro.SyncClient;component/Assets/app.ico"
    Width="1200" Height="760" MinWidth="980" MinHeight="600"
    Background="{StaticResource BgDark}"
    FontFamily="{StaticResource UiFont}"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    ResizeMode="CanMinimize"
    Closing="OnClosing">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== SIDEBAR ===================== -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo (yuksek cozunurluk) + teknolojik saat + tarih -->
                <StackPanel Grid.Row="0" Margin="16,18,16,8">
                    <Image Source="/AdCastPro.SyncClient;component/Assets/adcastpro-logo.png"
                           Stretch="Uniform" MaxHeight="118" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <!-- Teknolojik saat (zarif, dengeli) -->
                    <Border Margin="0,12,0,0" CornerRadius="13" Padding="12,9" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                                <GradientStop Color="#13203A" Offset="0" />
                                <GradientStop Color="#0A0F1A" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3A2230" Offset="0" />
                                <GradientStop Color="#1B2840" Offset="0.5" />
                                <GradientStop Color="#3A2230" Offset="1" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect Color="#E11D48" BlurRadius="22" ShadowDepth="0" Opacity="0.14" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="{Binding ClockTime}" HorizontalAlignment="Center"
                                       FontFamily="Consolas" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#E11D48" BlurRadius="12" ShadowDepth="0" Opacity="0.6" />
                                </TextBlock.Effect>
                            </TextBlock>

                            <!-- Aksan cizgisi -->
                            <Border Height="1.5" Margin="18,6,18,5" CornerRadius="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00E11D48" Offset="0" />
                                        <GradientStop Color="#E11D48" Offset="0.5" />
                                        <GradientStop Color="#00E11D48" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <TextBlock Text="{Binding ClockDay}" HorizontalAlignment="Center"
                                       Foreground="{StaticResource BrandRed}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="{Binding ClockDate}" HorizontalAlignment="Center"
                                       Foreground="{StaticResource FgPrimary}" FontSize="11.5" FontWeight="SemiBold" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Nav -->
                <StackPanel Grid.Row="1" Margin="0,4,0,0">
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="🏠" Content="Özet" IsChecked="True"
                                 Command="{Binding NavigateCommand}" CommandParameter="ozet" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="📋" Content="Yayın Listesi"
                                 Command="{Binding NavigateCommand}" CommandParameter="liste" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="⬇" Content="İndirilen Dosyalar"
                                 Command="{Binding NavigateCommand}" CommandParameter="indirilen" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="▶" Content="Yayın Kuşakları"
                                 Command="{Binding NavigateCommand}" CommandParameter="kusak" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="📄" Content="Raporlar"
                                 Command="{Binding NavigateCommand}" CommandParameter="raporlar" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="⚙" Content="Ayarlar"
                                 Command="{Binding NavigateCommand}" CommandParameter="ayarlar" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="◎" Content="Servis Durumu"
                                 Command="{Binding NavigateCommand}" CommandParameter="servis" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="⟳" Content="Güncellemeler"
                                 Command="{Binding NavigateCommand}" CommandParameter="guncelleme" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="🛟" Content="Destek"
                                 Command="{Binding NavigateCommand}" CommandParameter="destek" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="ⓘ" Content="Hakkında"
                                 Command="{Binding NavigateCommand}" CommandParameter="hakkinda" />
                </StackPanel>

                <!-- Alt durum (kompakt + teknolojik) -->
                <StackPanel Grid.Row="2" Margin="14,2,14,10">
                    <Border CornerRadius="10" Padding="11,8" Margin="0,0,0,7" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0E1A2C" Offset="0" />
                                <GradientStop Color="#0A0F1A" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#1C2A40" />
                        </Border.BorderBrush>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{StaticResource StatusGreen}" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Ellipse.Effect><DropShadowEffect Color="#10B981" BlurRadius="10" ShadowDepth="0" Opacity="0.95" /></Ellipse.Effect>
                            </Ellipse>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="SİSTEM DURUMU" Foreground="{StaticResource FgMuted}" FontSize="9" FontWeight="Bold" />
                                <TextBlock Text="{Binding ServiceStatusText}" Foreground="{StaticResource StatusGreen}" FontWeight="Bold" FontSize="13" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Foreground="{StaticResource FgDim}" FontSize="10">
                        <Run Text="Sürüm 1.0.0.0" /><Run Text="  •  © 2025 AdCast Pro" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== MAIN ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Content ===== -->
            <Grid Grid.Row="1">
                <!-- ============ ÖZET (kartlar alana tam oturur, yanlarda boşluk yok) ============ -->
                <StackPanel Margin="14,6,14,10" VerticalAlignment="Top"
                            Visibility="{Binding SelectedSection, Converter={StaticResource SectionToVis}, ConverterParameter=ozet}">

                        <!-- Üst sıra: 4 kart -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Bağlantı Durumu -->
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Bağlantı Durumu" Style="{StaticResource CardTitle}" />
                                    <Image Source="{Binding RadioLogoUrl}" Stretch="Uniform" MaxHeight="46"
                                           HorizontalAlignment="Left" Margin="0,0,0,10"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Ellipse Width="11" Height="11" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Ellipse.Fill><SolidColorBrush Color="{Binding ConnStatusColor}" /></Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Text="{Binding ConnStatusText}" FontWeight="Bold" FontSize="15">
                                            <TextBlock.Foreground><SolidColorBrush Color="{Binding ConnStatusColor}" /></TextBlock.Foreground>
                                        </TextBlock>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Sunucu: " Style="{StaticResource Muted}" Margin="0,3"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ServerAddress}" Style="{StaticResource ValueText}" Margin="0,3" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Kullanıcı: " Style="{StaticResource Muted}" Margin="0,3"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConnUserName}" Style="{StaticResource ValueText}" Margin="0,3"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="İstasyon: " Style="{StaticResource Muted}" Margin="0,3"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StationName}" Style="{StaticResource ValueText}" Margin="0,3"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Frekans: " Style="{StaticResource Muted}" Margin="0,3"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Frequency}" Style="{StaticResource ValueText}" Margin="0,3"/>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Bölge: " Style="{StaticResource Muted}" Margin="0,3"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RegionName}" Style="{StaticResource ValueText}" Margin="0,3"/>
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="İl: " Style="{StaticResource Muted}" Margin="0,3"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ProvinceName}" Style="{StaticResource ValueText}" Margin="0,3"/>
                                    </Grid>
                                    <Button Content="Bağlantıyı Test Et" Style="{StaticResource GhostButton}" Margin="0,14,0,0"
                                            Command="{Binding SyncNowCommand}" />
                                </StackPanel>
                            </Border>

                            <!-- Sistem Durumu -->
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Sistem Durumu" Style="{StaticResource CardTitle}" />
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Servis:" Style="{StaticResource Muted}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ServiceStatusText}" FontWeight="SemiBold" Foreground="{StaticResource StatusGreen}"/></Grid>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Bağlantı:" Style="{StaticResource Muted}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ConnStatusText}" FontWeight="SemiBold"><TextBlock.Foreground><SolidColorBrush Color="{Binding ConnStatusColor}"/></TextBlock.Foreground></TextBlock></Grid>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="İndirme Motoru:" Style="{StaticResource Muted}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding EngineStatusText}" FontWeight="SemiBold" Foreground="{StaticResource StatusGreen}"/></Grid>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Son Hata:" Style="{StaticResource Muted}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding LastErrorText}" FontWeight="SemiBold" Foreground="{StaticResource StatusGreen}"/></Grid>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Disk Alanı:" Style="{StaticResource Muted}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DiskText}" FontWeight="SemiBold" Foreground="{StaticResource FgPrimary}"/></Grid>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="İşlemci Kullanımı:" Style="{StaticResource Muted}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CpuText}" FontWeight="SemiBold" Foreground="{StaticResource FgPrimary}"/></Grid>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Bellek Kullanımı:" Style="{StaticResource Muted}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MemoryText}" FontWeight="SemiBold" Foreground="{StaticResource FgPrimary}"/></Grid>
                                </StackPanel>
                            </Border>

                            <!-- Yayın Kuşakları -->
                            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Yayın Kuşakları" Style="{StaticResource CardTitle}" />
                                    <ItemsControl ItemsSource="{Binding Slots}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3.5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Muted}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource FgPrimary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center">
                                                        <TextBlock.Foreground><SolidColorBrush Color="{Binding StatusColor}"/></TextBlock.Foreground>
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Tümünü Yenile" Style="{StaticResource GhostButton}" Margin="0,12,0,0"
                                            Command="{Binding RefreshListCommand}" />
                                </StackPanel>
                            </Border>

                            <!-- Yayın Hazırlık Durumu -->
                            <Border Grid.Column="3" Style="{StaticResource Card}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Yayın Hazırlık Durumu" Style="{StaticResource CardTitle}" />
                                    <ctl:DonutProgress Height="150" Width="150" HorizontalAlignment="Center" Margin="0,6,0,0" Percent="{Binding ReadinessPercent}" SubText="{Binding ReadinessLabel}">
                                        <ctl:DonutProgress.RingColor><SolidColorBrush Color="{Binding ReadinessColor}"/></ctl:DonutProgress.RingColor>
                                    </ctl:DonutProgress>
                                    <TextBlock Text="Tüm yayın dosyaları yayına hazır." Style="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    <TextBlock TextAlignment="Center" Margin="0,8,0,0">
                                        <Run Text="Son kontrol: " Foreground="{StaticResource FgDim}" FontSize="11.5"/>
                                        <Run Text="{Binding LastCheckTime}" Foreground="{StaticResource FgMuted}" FontSize="11.5" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <Button Content="Detayları Görüntüle" Style="{StaticResource GhostButton}" Margin="0,12,0,0"
                                            Command="{Binding NavigateCommand}" CommandParameter="kusak"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Orta sıra -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="1.15*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Son İndirilen Dosyalar -->
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Son İndirilen Dosyalar" Style="{StaticResource CardTitle}" />
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.2*"/><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="1.05*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Dosya Adı" Style="{StaticResource Muted}" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="Kuşak" Style="{StaticResource Muted}" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="Boyut" Style="{StaticResource Muted}" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="Tarih" Style="{StaticResource Muted}" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="4" Text="Durum" Style="{StaticResource Muted}" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <Grid MinHeight="170">
                                    <ItemsControl ItemsSource="{Binding RecentDownloads}" MaxHeight="170" VerticalAlignment="Top">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2.2*"/><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="1.05*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Icon}" FontSize="12" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding FileName}" Foreground="{StaticResource FgPrimary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Slot}" Style="{StaticResource Muted}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource Muted}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Date}" Style="{StaticResource Muted}"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding StatusText}" Foreground="{StaticResource StatusGreen}" FontSize="12" FontWeight="SemiBold"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,12">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RecentDownloads.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="📭" FontSize="26" HorizontalAlignment="Center" Opacity="0.5"/>
                                            <TextBlock Text="Henüz dosya indirilmedi" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            <TextBlock Text="İlk senkronizasyonda dosyalar burada listelenir." Foreground="{StaticResource FgDim}" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Button Content="📁 Tüm Dosyaları Görüntüle" Style="{StaticResource GhostButton}" Margin="0,12,0,0" HorizontalAlignment="Left"
                                            Command="{Binding NavigateCommand}" CommandParameter="indirilen"/>
                                </StackPanel>
                            </Border>

                            <!-- İndirme Durumu -->
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="İndirme Durumu" Style="{StaticResource CardTitle}" />
                                    <ctl:DonutProgress Height="140" Width="140" HorizontalAlignment="Center" Margin="0,6,0,0" Percent="{Binding DownloadPercent}" SubText="Tamamlandı">
                                        <ctl:DonutProgress.RingColor><SolidColorBrush Color="#10B981"/></ctl:DonutProgress.RingColor>
                                    </ctl:DonutProgress>
                                    <StackPanel Margin="0,10,0,0">
                                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Toplam Dosya:" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding TotalFilesText}" Style="{StaticResource ValueText}"/></Grid>
                                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="İndirilen:" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding DownloadedFilesText}" Style="{StaticResource ValueText}"/></Grid>
                                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Kalan:" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding RemainingFilesText}" Style="{StaticResource ValueText}"/></Grid>
                                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Toplam Boyut:" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding TotalSizeText}" Style="{StaticResource ValueText}"/></Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Yayın Hazırlık Kontrolü -->
                            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Yayın Hazırlık Kontrolü" Style="{StaticResource CardTitle}" />
                                    <ItemsControl ItemsSource="{Binding Checks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3.5">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="✓" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"><TextBlock.Foreground><SolidColorBrush Color="{Binding Color}"/></TextBlock.Foreground></TextBlock>
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{StaticResource FgPrimary}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Mark}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"><TextBlock.Foreground><SolidColorBrush Color="{Binding Color}"/></TextBlock.Foreground></TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="{Binding ReadyToAirText}" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                                            Background="{StaticResource StatusGreen}" FontWeight="Bold"
                                            Command="{Binding SyncNowCommand}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Alt sıra -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/><ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Konsol -->
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Konsol" Style="{StaticResource CardTitle}"/>
                                        <Button Content="Temizle" Style="{StaticResource GhostButton}" Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                FontSize="11" Command="{Binding ClearConsoleCommand}"/>
                                    </Grid>
                                    <Border Background="#070B14" CornerRadius="8" Padding="12" Height="120">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ConsoleLines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11.5" Foreground="#86EFAC" Margin="0,1"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Hızlı İşlemler -->
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Hızlı İşlemler" Style="{StaticResource CardTitle}"/>

                                    <!-- Son Senkronizasyon bilgi barı -->
                                    <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="SON SENKRONİZASYON" Style="{StaticResource Muted}" FontSize="10"/>
                                                <TextBlock Text="{Binding LastSyncTime}" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="⟳" FontSize="14" Width="34" Height="34" Style="{StaticResource GhostButton}" Padding="0" VerticalAlignment="Center" ToolTip="Yenile" Command="{Binding RefreshCommand}"/>
                                        </Grid>
                                    </Border>

                                    <Button Content="☁ Şimdi Senkronize Et" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" Command="{Binding SyncNowCommand}"/>
                                    <Button Content="≣ Yayın Listesini Yenile" Style="{StaticResource GhostButton}" Margin="0,0,0,8" Command="{Binding RefreshListCommand}"/>
                                    <Button Content="📈 Geçmiş Raporları Göster" Style="{StaticResource GhostButton}" Margin="0,0,0,8" Command="{Binding NavigateCommand}" CommandParameter="raporlar"/>
                                    <Button Content="⚙ Ayarları Aç" Style="{StaticResource GhostButton}" Command="{Binding NavigateCommand}" CommandParameter="ayarlar"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                </StackPanel>

                <!-- ============ DİĞER BÖLÜMLER (scroll'lu) ============ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,12,24,16">
                    <StackPanel>
                    <Border Style="{StaticResource Card}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionToVis}, ConverterParameter=indirilen}">
                        <StackPanel>
                            <TextBlock Text="İndirilen Dosyalar" Style="{StaticResource CardTitle}"/>
                            <ItemsControl ItemsSource="{Binding RecentDownloads}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FileName}" Foreground="{StaticResource FgPrimary}" FontSize="12.5"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Size}" Style="{StaticResource Muted}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Date}" Style="{StaticResource Muted}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding StatusText}" Foreground="{StaticResource StatusGreen}" FontSize="12.5"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionToVis}, ConverterParameter=kusak}">
                        <StackPanel>
                            <TextBlock Text="Yayın Kuşakları" Style="{StaticResource CardTitle}"/>
                            <ItemsControl ItemsSource="{Binding Slots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource FgPrimary}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontWeight="Bold"><TextBlock.Foreground><SolidColorBrush Color="{Binding StatusColor}"/></TextBlock.Foreground></TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionToVis}, ConverterParameter=liste}">
                        <StackPanel>
                            <TextBlock Text="Yayın Listesi" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Sunucudan alınan güncel yayın kuşağı planı." Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding Slots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource FgPrimary}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontWeight="Bold"><TextBlock.Foreground><SolidColorBrush Color="{Binding StatusColor}"/></TextBlock.Foreground></TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionToVis}, ConverterParameter=servis}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Servis Durumu — Sistem İzleme" Style="{StaticResource CardTitle}"/>
                                <Border Grid.Column="1" Background="#10331F" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource StatusGreen}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="CANLI" Foreground="{StaticResource StatusGreen}" FontWeight="Bold" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Kaynak gauge'lari: CPU / RAM / Disk -->
                            <UniformGrid Columns="3" Margin="0,6,0,2">
                                <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="8,8" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="İŞLEMCİ (CPU)" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center"/>
                                        <ctl:DonutProgress Height="94" Width="94" HorizontalAlignment="Center" Margin="0,2,0,0" Percent="{Binding CpuPercent}" SubText="kullanım">
                                            <ctl:DonutProgress.RingColor><SolidColorBrush Color="{Binding CpuColor}"/></ctl:DonutProgress.RingColor>
                                        </ctl:DonutProgress>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="8,8" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="BELLEK (RAM)" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center"/>
                                        <ctl:DonutProgress Height="94" Width="94" HorizontalAlignment="Center" Margin="0,2,0,0" Percent="{Binding MemoryPercent}" SubText="kullanım">
                                            <ctl:DonutProgress.RingColor><SolidColorBrush Color="{Binding MemoryColor}"/></ctl:DonutProgress.RingColor>
                                        </ctl:DonutProgress>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="8,8">
                                    <StackPanel>
                                        <TextBlock Text="DİSK" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center"/>
                                        <ctl:DonutProgress Height="94" Width="94" HorizontalAlignment="Center" Margin="0,2,0,0" Percent="{Binding DiskUsedPercent}" SubText="dolu">
                                            <ctl:DonutProgress.RingColor><SolidColorBrush Color="{Binding DiskColor}"/></ctl:DonutProgress.RingColor>
                                        </ctl:DonutProgress>
                                        <TextBlock Text="{Binding DiskUsedText}" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        <TextBlock HorizontalAlignment="Center" FontSize="11"><Run Text="Boş: " Foreground="{StaticResource FgMuted}"/><Run Text="{Binding FreeSpaceText}" Foreground="{StaticResource StatusGreen}"/></TextBlock>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Gecmis grafikleri: CPU & RAM (sparkline) -->
                            <UniformGrid Columns="2" Margin="0,6,0,2">
                                <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="İşlemci Geçmişi" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="12.5"/>
                                            <TextBlock Text="{Binding CpuText}" Foreground="#38BDF8" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Border Background="#070B14" CornerRadius="8" Margin="0,8,0,0" Padding="6">
                                            <Viewbox Height="48" Stretch="Fill">
                                                <Grid Width="300" Height="70">
                                                    <Line X1="0" Y1="17.5" X2="300" Y2="17.5" Stroke="{StaticResource BorderColor}" StrokeThickness="0.5"/>
                                                    <Line X1="0" Y1="35" X2="300" Y2="35" Stroke="{StaticResource BorderColor}" StrokeThickness="0.5"/>
                                                    <Line X1="0" Y1="52.5" X2="300" Y2="52.5" Stroke="{StaticResource BorderColor}" StrokeThickness="0.5"/>
                                                    <Polygon Points="{Binding CpuAreaPoints}">
                                                        <Polygon.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#6638BDF8" Offset="0"/>
                                                                <GradientStop Color="#0038BDF8" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Polygon.Fill>
                                                    </Polygon>
                                                    <Polyline Points="{Binding CpuPoints}" Stroke="#38BDF8" StrokeThickness="2.5" StrokeLineJoin="Round">
                                                        <Polyline.Effect><DropShadowEffect Color="#38BDF8" BlurRadius="7" ShadowDepth="0" Opacity="0.9"/></Polyline.Effect>
                                                    </Polyline>
                                                </Grid>
                                            </Viewbox>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Bellek Geçmişi" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="12.5"/>
                                            <TextBlock Text="{Binding MemoryText}" Foreground="#A78BFA" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Border Background="#070B14" CornerRadius="8" Margin="0,8,0,0" Padding="6">
                                            <Viewbox Height="48" Stretch="Fill">
                                                <Grid Width="300" Height="70">
                                                    <Line X1="0" Y1="17.5" X2="300" Y2="17.5" Stroke="{StaticResource BorderColor}" StrokeThickness="0.5"/>
                                                    <Line X1="0" Y1="35" X2="300" Y2="35" Stroke="{StaticResource BorderColor}" StrokeThickness="0.5"/>
                                                    <Line X1="0" Y1="52.5" X2="300" Y2="52.5" Stroke="{StaticResource BorderColor}" StrokeThickness="0.5"/>
                                                    <Polygon Points="{Binding MemoryAreaPoints}">
                                                        <Polygon.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#66A78BFA" Offset="0"/>
                                                                <GradientStop Color="#00A78BFA" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Polygon.Fill>
                                                    </Polygon>
                                                    <Polyline Points="{Binding MemoryPoints}" Stroke="#A78BFA" StrokeThickness="2.5" StrokeLineJoin="Round">
                                                        <Polyline.Effect><DropShadowEffect Color="#A78BFA" BlurRadius="7" ShadowDepth="0" Opacity="0.9"/></Polyline.Effect>
                                                    </Polyline>
                                                </Grid>
                                            </Viewbox>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Servis sagligi kartlari -->
                            <UniformGrid Columns="4" Margin="0,6,0,2">
                                <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="12,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="SENKRONİZASYON SERVİSİ" Style="{StaticResource Muted}" FontSize="10"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Ellipse Width="9" Height="9" Fill="{StaticResource StatusGreen}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock Text="{Binding ServiceStatusText}" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="14"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="12,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="İNDİRME MOTORU" Style="{StaticResource Muted}" FontSize="10"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Ellipse Width="9" Height="9" Fill="{StaticResource StatusGreen}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock Text="{Binding EngineStatusText}" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="14"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="12,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="SUNUCU BAĞLANTISI" Style="{StaticResource Muted}" FontSize="10"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,7,0"><Ellipse.Fill><SolidColorBrush Color="{Binding ConnStatusColor}"/></Ellipse.Fill></Ellipse>
                                            <TextBlock Text="{Binding ConnStatusText}" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="14"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="12,12">
                                    <StackPanel>
                                        <TextBlock Text="ÇALIŞMA SÜRESİ" Style="{StaticResource Muted}" FontSize="10"/>
                                        <TextBlock Text="{Binding UptimeText}" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="14" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Senkronizasyon & Ag bilgileri + Son olaylar -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Senkronizasyon &amp; Ağ" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,8"/>
                                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Sunucu" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding ServerAddress}" Foreground="{StaticResource FgPrimary}"/></Grid>
                                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Bağlantı" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding ConnStatusText}"><TextBlock.Foreground><SolidColorBrush Color="{Binding ConnStatusColor}"/></TextBlock.Foreground></TextBlock></Grid>
                                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Son senkronizasyon" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding LastSyncTime}" Foreground="{StaticResource FgPrimary}"/></Grid>
                                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Son kontrol" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding LastCheckTime}" Foreground="{StaticResource FgPrimary}"/></Grid>
                                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Tarama aralığı" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding PollIntervalText}" Foreground="{StaticResource FgPrimary}"/></Grid>
                                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Heartbeat" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding HeartbeatText}" Foreground="{StaticResource FgPrimary}"/></Grid>
                                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Son hata" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding LastErrorText}" Foreground="{StaticResource FgPrimary}"/></Grid>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="Son Olaylar" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,8"/>
                                        <Border Background="#070B14" CornerRadius="8" Height="96" Padding="8">
                                            <ItemsControl ItemsSource="{Binding ConsoleLines}">
                                                <ItemsControl.Template>
                                                    <ControlTemplate>
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                                                    </ControlTemplate>
                                                </ItemsControl.Template>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Foreground="#86EFAC" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" Margin="0,1"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionToVis}, ConverterParameter=raporlar}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Raporlar — Operasyonel Özet" Style="{StaticResource CardTitle}"/>
                                <Button Grid.Column="1" Content="🔄 Yenile" Style="{StaticResource GhostButton}" Padding="14,6" Command="{Binding RefreshCommand}"/>
                            </Grid>

                            <!-- Özet istatistik kartları -->
                            <UniformGrid Columns="4" Margin="0,6,0,16">
                                <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="TOPLAM İNDİRİLEN" Style="{StaticResource Muted}" FontSize="10.5"/>
                                        <TextBlock Margin="0,4,0,0"><Run Text="{Binding ReportTotalFiles}" Foreground="{StaticResource FgPrimary}" FontSize="22" FontWeight="Bold"/><Run Text=" dosya" Foreground="{StaticResource FgMuted}" FontSize="12"/></TextBlock>
                                        <TextBlock Text="{Binding ReportTotalSize}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="BUGÜN İNDİRİLEN" Style="{StaticResource Muted}" FontSize="10.5"/>
                                        <TextBlock Margin="0,4,0,0"><Run Text="{Binding ReportTodayFiles}" Foreground="{StaticResource StatusGreen}" FontSize="22" FontWeight="Bold"/><Run Text=" dosya" Foreground="{StaticResource FgMuted}" FontSize="12"/></TextBlock>
                                        <TextBlock Text="{Binding ReportTodaySize}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="HAZIR YAYIN KUŞAĞI" Style="{StaticResource Muted}" FontSize="10.5"/>
                                        <TextBlock Text="{Binding ReportSlotsReady}" Foreground="{StaticResource FgPrimary}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                                        <TextBlock Text="hazır / toplam" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="SON SENKRONİZASYON" Style="{StaticResource Muted}" FontSize="10.5"/>
                                        <TextBlock Text="{Binding ReportLastSync}" Foreground="{StaticResource FgPrimary}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Yayın Kuşağı Durumu -->
                            <TextBlock Text="Yayın Kuşağı Durumu" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding Slots}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource FgPrimary}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontWeight="Bold"><TextBlock.Foreground><SolidColorBrush Color="{Binding StatusColor}"/></TextBlock.Foreground></TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- İndirilen Dosyalar (detaylı) -->
                            <TextBlock Text="İndirilen Dosyalar (Detaylı)" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Dosya" Style="{StaticResource Muted}" FontSize="11"/>
                                <TextBlock Grid.Column="1" Text="Boyut" Style="{StaticResource Muted}" FontSize="11"/>
                                <TextBlock Grid.Column="2" Text="Tarih" Style="{StaticResource Muted}" FontSize="11"/>
                                <TextBlock Grid.Column="3" Text="Durum" Style="{StaticResource Muted}" FontSize="11"/>
                            </Grid>
                            <Border Background="{StaticResource BorderColor}" Height="1" Margin="0,0,0,2"/>
                            <Grid MinHeight="230">
                            <ItemsControl ItemsSource="{Binding RecentDownloads}" VerticalAlignment="Top">
                                <ItemsControl.Template>
                                    <ControlTemplate>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320"><ItemsPresenter/></ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding FileName}" Foreground="{StaticResource FgPrimary}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Size}" Style="{StaticResource Muted}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Date}" Style="{StaticResource Muted}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding StatusText}" Foreground="{StaticResource StatusGreen}" FontSize="12.5"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RecentDownloads.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="📭" FontSize="30" HorizontalAlignment="Center" Opacity="0.5"/>
                                    <TextBlock Text="Henüz dosya indirilmedi" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBlock Text="İlk senkronizasyonda indirilen dosyalar burada listelenir." Foreground="{StaticResource FgDim}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Button Content="🛠 Teknik Günlükler (Sorun Giderme)" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Padding="14,8" Click="OnLogs"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionToVis}, ConverterParameter=ayarlar}">
                        <StackPanel DataContext="{Binding SettingsVm}">
                            <TextBlock Text="Ayarlar" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="İçerik klasörleri — her tür kendi klasörüne indirilir. Klasör seçmek için 📁 simgesini kullanın." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <!-- Klasorler: 2 sutunlu kompakt izgara (scroll yok) -->
                            <UniformGrid Columns="2">
                                <!-- 1 -->
                                <StackPanel Margin="0,0,12,12">
                                    <TextBlock Text="Haber" Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,3"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7" Height="34"><TextBox Text="{Binding NewsFolder, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="9,0" FontSize="12"/></Border>
                                        <Button Grid.Column="1" Content="📁" ToolTip="Gözat" Width="38" Height="34" Margin="6,0,0,0" Style="{StaticResource GhostButton}" Padding="0" Command="{Binding BrowseNewsCommand}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- 2 -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Reklam" Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,3"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7" Height="34"><TextBox Text="{Binding AdsFolder, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="9,0" FontSize="12"/></Border>
                                        <Button Grid.Column="1" Content="📁" ToolTip="Gözat" Width="38" Height="34" Margin="6,0,0,0" Style="{StaticResource GhostButton}" Padding="0" Command="{Binding BrowseAdsCommand}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- 3 -->
                                <StackPanel Margin="0,0,12,12">
                                    <TextBlock Text="Medya Planı" Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,3"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7" Height="34"><TextBox Text="{Binding MediaPlansFolder, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="9,0" FontSize="12"/></Border>
                                        <Button Grid.Column="1" Content="📁" ToolTip="Gözat" Width="38" Height="34" Margin="6,0,0,0" Style="{StaticResource GhostButton}" Padding="0" Command="{Binding BrowseMediaPlansCommand}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- 4 -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Sponsor" Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,3"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7" Height="34"><TextBox Text="{Binding SponsorsFolder, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="9,0" FontSize="12"/></Border>
                                        <Button Grid.Column="1" Content="📁" ToolTip="Gözat" Width="38" Height="34" Margin="6,0,0,0" Style="{StaticResource GhostButton}" Padding="0" Command="{Binding BrowseSponsorsCommand}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- 5 -->
                                <StackPanel Margin="0,0,12,12">
                                    <TextBlock Text="Acil Anons" Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,3"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7" Height="34"><TextBox Text="{Binding EmergencyFolder, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="9,0" FontSize="12"/></Border>
                                        <Button Grid.Column="1" Content="📁" ToolTip="Gözat" Width="38" Height="34" Margin="6,0,0,0" Style="{StaticResource GhostButton}" Padding="0" Command="{Binding BrowseEmergencyCommand}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- 6 -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Tanıtım (Promo)" Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,3"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7" Height="34"><TextBox Text="{Binding PromoFolder, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="9,0" FontSize="12"/></Border>
                                        <Button Grid.Column="1" Content="📁" ToolTip="Gözat" Width="38" Height="34" Margin="6,0,0,0" Style="{StaticResource GhostButton}" Padding="0" Command="{Binding BrowsePromoCommand}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- 7 -->
                                <StackPanel Margin="0,0,12,12">
                                    <TextBlock Text="Cıngıl (Jingle)" Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,3"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7" Height="34"><TextBox Text="{Binding JingleFolder, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="9,0" FontSize="12"/></Border>
                                        <Button Grid.Column="1" Content="📁" ToolTip="Gözat" Width="38" Height="34" Margin="6,0,0,0" Style="{StaticResource GhostButton}" Padding="0" Command="{Binding BrowseJingleCommand}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- 8 -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Bölgesel İçerik" Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,3"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7" Height="34"><TextBox Text="{Binding RegionalFolder, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="9,0" FontSize="12"/></Border>
                                        <Button Grid.Column="1" Content="📁" ToolTip="Gözat" Width="38" Height="34" Margin="6,0,0,0" Style="{StaticResource GhostButton}" Padding="0" Command="{Binding BrowseRegionalCommand}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- 9 -->
                                <StackPanel Margin="0,0,12,12">
                                    <TextBlock Text="Ulusal İçerik" Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,3"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7" Height="34"><TextBox Text="{Binding NationalFolder, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="9,0" FontSize="12"/></Border>
                                        <Button Grid.Column="1" Content="📁" ToolTip="Gözat" Width="38" Height="34" Margin="6,0,0,0" Style="{StaticResource GhostButton}" Padding="0" Command="{Binding BrowseNationalCommand}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- 10 -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Arşiv" Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,3"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7" Height="34"><TextBox Text="{Binding ArchiveFolder, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="9,0" FontSize="12"/></Border>
                                        <Button Grid.Column="1" Content="📁" ToolTip="Gözat" Width="38" Height="34" Margin="6,0,0,0" Style="{StaticResource GhostButton}" Padding="0" Command="{Binding BrowseArchiveCommand}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- 11 -->
                                <StackPanel Margin="0,0,12,12">
                                    <TextBlock Text="Geçici Dosyalar" Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,3"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7" Height="34"><TextBox Text="{Binding TempFolder, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="9,0" FontSize="12"/></Border>
                                        <Button Grid.Column="1" Content="📁" ToolTip="Gözat" Width="38" Height="34" Margin="6,0,0,0" Style="{StaticResource GhostButton}" Padding="0" Command="{Binding BrowseTempCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </UniformGrid>

                            <!-- Senkronizasyon ayarlari + Kaydet -->
                            <Border Background="{StaticResource BorderColor}" Height="1" Margin="0,4,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Tarama aralığı (sn):" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7" Height="34" Width="80"><TextBox Text="{Binding PollIntervalSeconds}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="9,0" FontSize="12.5"/></Border>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Content="Windows ile birlikte başlat" Foreground="{StaticResource FgPrimary}" IsChecked="{Binding AutoStartWithWindows}" VerticalAlignment="Center" Margin="22,0,0,0"/>
                                <Button Grid.Column="2" Content="Kaydet" Style="{StaticResource PrimaryButton}" Padding="26,9" Command="{Binding SaveCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ====== DESTEK ====== -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionToVis}, ConverterParameter=destek}">
                        <StackPanel DataContext="{Binding SupportVm}" MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="Destek Talebi" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Bir sorununuz mu var? Aşağıdaki formu doldurun; ekibimiz en kısa sürede sizinle iletişime geçecektir." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <!-- Radyo Bilgileri (otomatik, salt-okunur) -->
                            <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="📻 RADYO BİLGİLERİ (otomatik)" Style="{StaticResource Muted}" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,12,8"><TextBlock Text="Radyo Adı" Foreground="{StaticResource FgDim}" FontSize="11"/><TextBlock Text="{Binding RadioName}" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="13"/></StackPanel>
                                        <StackPanel Margin="0,0,0,8"><TextBlock Text="Frekans" Foreground="{StaticResource FgDim}" FontSize="11"/><TextBlock Text="{Binding Frequency}" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="13"/></StackPanel>
                                        <StackPanel Margin="0,0,12,0"><TextBlock Text="Bölge" Foreground="{StaticResource FgDim}" FontSize="11"/><TextBlock Text="{Binding Region}" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="13"/></StackPanel>
                                        <StackPanel><TextBlock Text="İl" Foreground="{StaticResource FgDim}" FontSize="11"/><TextBlock Text="{Binding City}" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="13"/></StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Manuel alanlar -->
                            <TextBlock Text="Ad Soyad *" Style="{StaticResource Muted}" Margin="0,2,0,4"/>
                            <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Height="40" Margin="0,0,0,12">
                                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="10,0"/>
                            </Border>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Telefon *" Style="{StaticResource Muted}" Margin="0,2,0,4"/>
                                    <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Height="40">
                                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="10,0"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="E-posta *" Style="{StaticResource Muted}" Margin="0,2,0,4"/>
                                    <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Height="40">
                                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="10,0"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Destek Mesajı *" Style="{StaticResource Muted}" Margin="0,2,0,4"/>
                            <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Height="130" Margin="0,0,0,4">
                                <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Padding="10,8"/>
                            </Border>
                            <TextBlock Text="En az 10 karakter." Foreground="{StaticResource FgDim}" FontSize="11" Margin="0,0,0,8"/>

                            <!-- Durum mesaji -->
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12.5" Margin="0,2,0,10"
                                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource StatusGreen}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource StatusRed}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button Command="{Binding SubmitCommand}" HorizontalAlignment="Left" Padding="24,11">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Content" Value="📨 Destek Talebi Gönder"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSubmitting}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Content" Value="Gönderiliyor…"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionToVis}, ConverterParameter=guncelleme}">
                        <StackPanel>
                            <TextBlock Text="Güncellemeler" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Mevcut sürüm: 1.0.0.0" Style="{StaticResource Muted}"/>
                            <TextBlock Text="Otomatik güncelleme etkin." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionToVis}, ConverterParameter=hakkinda}">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="680" Margin="0,8,0,8">
                            <!-- Logo -->
                            <Image Source="/AdCastPro.SyncClient;component/Assets/adcastpro-logo.png"
                                   Stretch="Uniform" MaxHeight="110" HorizontalAlignment="Center" Margin="0,0,0,4"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="Yayın Senkronizasyon İstemcisi" Style="{StaticResource Muted}" HorizontalAlignment="Center" FontSize="13"/>
                            <TextBlock Text="Planla. Yayınla. Raporla." Foreground="{StaticResource BrandRed}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="13"/>

                            <!-- Aksan cizgisi -->
                            <Border Height="2" Width="120" CornerRadius="1" Margin="0,16,0,16" HorizontalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00E11D48" Offset="0"/>
                                        <GradientStop Color="#E11D48" Offset="0.5"/>
                                        <GradientStop Color="#00E11D48" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Profesyonel aciklama -->
                            <TextBlock Foreground="{StaticResource FgPrimary}" FontSize="13.5" TextAlignment="Center" TextWrapping="Wrap" LineHeight="22"
                                       Text="AdCast Pro, radyo istasyonları için geliştirilmiş profesyonel bir yayın senkronizasyon ve içerik dağıtım platformudur. Haber bültenleri, reklamlar, cıngıllar, tanıtımlar ve sponsor içeriklerini merkezi sunucudan otomatik olarak indirir; yayın kuşaklarına göre düzenler ve istasyonunuzun her an yayına hazır olmasını sağlar."/>
                            <TextBlock Foreground="{StaticResource FgMuted}" FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0"
                                       Text="Uçtan uca güvenli dosya doğrulama, gerçek zamanlı sistem izleme ve kesintisiz otomatik güncelleme ile yayın sürekliliğinizi güvence altına alır."/>

                            <!-- Ozellikler -->
                            <UniformGrid Columns="2" Margin="0,18,0,4">
                                <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,6,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔄" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <StackPanel><TextBlock Text="Otomatik Senkronizasyon" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="Merkezden gerçek zamanlı içerik" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="6,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📻" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <StackPanel><TextBlock Text="Yayın Kuşağı Yönetimi" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="Günlük plana göre hazırlık" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🛡" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <StackPanel><TextBlock Text="Güvenli Doğrulama" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="Bütünlük ve format kontrolü" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📊" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <StackPanel><TextBlock Text="Sistem İzleme" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="CPU, bellek, disk ve sağlık" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Alt bilgi -->
                            <Border Background="{StaticResource BorderColor}" Height="1" Margin="0,18,0,12"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Sürüm 1.0.0.0" Style="{StaticResource Muted}" FontSize="12"/>
                                <TextBlock Text="  •  " Foreground="{StaticResource FgDim}" FontSize="12"/>
                                <TextBlock Text="© 2025 AdCast Pro" Style="{StaticResource Muted}" FontSize="12"/>
                                <TextBlock Text="  •  " Foreground="{StaticResource FgDim}" FontSize="12"/>
                                <TextBlock Text="Tüm hakları saklıdır." Foreground="{StaticResource FgDim}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="24,9">
                <StackPanel Orientation="Horizontal">
                    <TextBlock><Run Text="Durum: " Foreground="{StaticResource FgMuted}" FontSize="12"/><Run Text="{Binding ServiceStatusText}" Foreground="{StaticResource StatusGreen}" FontSize="12" FontWeight="SemiBold"/></TextBlock>
                    <TextBlock Margin="24,0,0,0"><Run Text="Bağlantı: " Foreground="{StaticResource FgMuted}" FontSize="12"/><Run Text="{Binding ServerAddress}" Foreground="{StaticResource FgPrimary}" FontSize="12"/></TextBlock>
                    <TextBlock Margin="24,0,0,0"><Run Text="Kullanıcı: " Foreground="{StaticResource FgMuted}" FontSize="12"/><Run Text="{Binding ConnUserName}" Foreground="{StaticResource FgPrimary}" FontSize="12"/></TextBlock>
                    <TextBlock Margin="24,0,0,0"><Run Text="İstasyon: " Foreground="{StaticResource FgMuted}" FontSize="12"/><Run Text="{Binding StationName}" Foreground="{StaticResource FgPrimary}" FontSize="12"/></TextBlock>
                    <TextBlock Margin="24,0,0,0"><Run Text="Bölge: " Foreground="{StaticResource FgMuted}" FontSize="12"/><Run Text="{Binding RegionName}" Foreground="{StaticResource FgPrimary}" FontSize="12"/></TextBlock>
                    <TextBlock Margin="24,0,0,0"><Run Text="İl: " Foreground="{StaticResource FgMuted}" FontSize="12"/><Run Text="{Binding ProvinceName}" Foreground="{StaticResource FgPrimary}" FontSize="12"/></TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
