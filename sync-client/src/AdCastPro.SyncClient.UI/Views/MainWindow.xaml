                                            </Border>
                                        </Grid>
                                        <Border Background="#070B14" CornerRadius="8" Margin="0,10,0,0" Padding="10,9" BorderBrush="#0E1A2A" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Grid Grid.Row="0" Grid.Column="0" Height="84" Margin="0,0,8,0">
                                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="100%" Foreground="{StaticResource FgDim}" FontSize="8.5" VerticalAlignment="Top"/>
                                                    <TextBlock Grid.Row="1" Text="75%" Foreground="{StaticResource FgDim}" FontSize="8.5" VerticalAlignment="Top"/>
                                                    <TextBlock Grid.Row="2" Text="50%" Foreground="{StaticResource FgDim}" FontSize="8.5" VerticalAlignment="Top"/>
                                                    <TextBlock Grid.Row="3" Text="25%" Foreground="{StaticResource FgDim}" FontSize="8.5" VerticalAlignment="Top"/>
                                                    <TextBlock Grid.Row="3" Text="0%" Foreground="{StaticResource FgDim}" FontSize="8.5" VerticalAlignment="Bottom"/>
                                                </Grid>
                                                <Viewbox Grid.Row="0" Grid.Column="1" Height="84" Stretch="Fill">
                                                    <Grid Width="300" Height="70">
                                                        <Line X1="0" Y1="17.5" X2="300" Y2="17.5" Stroke="{StaticResource BorderColor}" StrokeThickness="0.5"/>
                                                        <Line X1="0" Y1="35" X2="300" Y2="35" Stroke="{StaticResource BorderColor}" StrokeThickness="0.5"/>
                                                        <Line X1="0" Y1="52.5" X2="300" Y2="52.5" Stroke="{StaticResource BorderColor}" StrokeThickness="0.5"/>
                                                        <Polygon Points="{Binding CpuAreaPoints}">
                                                            <Polygon.Fill>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#6638BDF8" Offset="0"/>
                                                                    <GradientStop Color="#0038BDF8" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Polygon.Fill>
                                                        </Polygon>
                                                        <Polyline Points="{Binding CpuPoints}" Stroke="#38BDF8" StrokeThickness="2.5" StrokeLineJoin="Round">
                                                            <Polyline.Effect><DropShadowEffect Color="#38BDF8" BlurRadius="7" ShadowDepth="0" Opacity="0.9"/></Polyline.Effect>
                                                        </Polyline>
                                                    </Grid>
                                                </Viewbox>
                                                <Grid Grid.Row="1" Grid.Column="1" Margin="0,5,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="-60sn" Foreground="{StaticResource FgDim}" FontSize="8.5"/>
                                                    <TextBlock Grid.Column="1" Text="-40sn" Foreground="{StaticResource FgDim}" FontSize="8.5" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="-20sn" Foreground="{StaticResource FgDim}" FontSize="8.5" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="Şimdi" Foreground="{StaticResource FgMuted}" FontSize="8.5" FontWeight="SemiBold"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="20" Height="20" CornerRadius="5" Background="#241F3C" Margin="0,0,8,0"><iconPacks:PackIconLucide Kind="Activity" Width="11" Height="11" Foreground="#A78BFA" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                <TextBlock Text="Bellek Geçmişi" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right" CornerRadius="6" Padding="8,2" Background="#1A1530" BorderBrush="#3B2F66" BorderThickness="1">
                                                <TextBlock Text="{Binding MemoryText}" Foreground="#A78BFA" FontWeight="Bold" FontSize="12"/>
                                            </Border>
                                        </Grid>
                                        <Border Background="#070B14" CornerRadius="8" Margin="0,10,0,0" Padding="10,9" BorderBrush="#0E1A2A" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Grid Grid.Row="0" Grid.Column="0" Height="84" Margin="0,0,8,0">
                                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="100%" Foreground="{StaticResource FgDim}" FontSize="8.5" VerticalAlignment="Top"/>
                                                    <TextBlock Grid.Row="1" Text="75%" Foreground="{StaticResource FgDim}" FontSize="8.5" VerticalAlignment="Top"/>
                                                    <TextBlock Grid.Row="2" Text="50%" Foreground="{StaticResource FgDim}" FontSize="8.5" VerticalAlignment="Top"/>
                                                    <TextBlock Grid.Row="3" Text="25%" Foreground="{StaticResource FgDim}" FontSize="8.5" VerticalAlignment="Top"/>
                                                    <TextBlock Grid.Row="3" Text="0%" Foreground="{StaticResource FgDim}" FontSize="8.5" VerticalAlignment="Bottom"/>
                                                </Grid>
                                                <Viewbox Grid.Row="0" Grid.Column="1" Height="84" Stretch="Fill">
                                                    <Grid Width="300" Height="70">
                                                        <Line X1="0" Y1="17.5" X2="300" Y2="17.5" Stroke="{StaticResource BorderColor}" StrokeThickness="0.5"/>
                                                        <Line X1="0" Y1="35" X2="300" Y2="35" Stroke="{StaticResource BorderColor}" StrokeThickness="0.5"/>
