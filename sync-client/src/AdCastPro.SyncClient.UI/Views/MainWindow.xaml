                                                <Border CornerRadius="6" Padding="7,2" HorizontalAlignment="Left" Background="#0C1726" BorderThickness="1">
                                                    <Border.BorderBrush><SolidColorBrush Color="{Binding DiskColor}" Opacity="0.4"/></Border.BorderBrush>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center"><Ellipse.Fill><SolidColorBrush Color="{Binding DiskColor}"/></Ellipse.Fill></Ellipse>
