                                                    <Border.BorderBrush><SolidColorBrush Color="{Binding MemoryColor}" Opacity="0.4"/></Border.BorderBrush>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center"><Ellipse.Fill><SolidColorBrush Color="{Binding MemoryColor}"/></Ellipse.Fill></Ellipse>
                                                        <TextBlock Text="{Binding MemoryLevelText}" FontSize="10.5" FontWeight="Bold"><TextBlock.Foreground><SolidColorBrush Color="{Binding MemoryColor}"/></TextBlock.Foreground></TextBlock>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="{Binding MemoryLevelDetail}" Foreground="{StaticResource FgDim}" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <!-- DİSK -->
                                <Border CornerRadius="14" Padding="15,13" BorderThickness="1" BorderBrush="#15402F">
                                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1"><GradientStop Color="#0F2018" Offset="0"/><GradientStop Color="#091410" Offset="1"/></LinearGradientBrush></Border.Background>
                                    <Border.Effect><DropShadowEffect Color="#000814" BlurRadius="16" ShadowDepth="0" Opacity="0.40"/></Border.Effect>
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="22" Height="22" CornerRadius="6" Background="#10301F" Margin="0,0,8,0"><iconPacks:PackIconLucide Kind="HardDrive" Width="12" Height="12" Foreground="#19C37D" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                <TextBlock Text="DİSK" Style="{StaticResource Muted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Polyline HorizontalAlignment="Right" VerticalAlignment="Center" Points="0,8 4,8 6,3 9,11 12,5 15,8 26,8" Stroke="#19C37D" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                                        </Grid>
                                        <Grid Margin="0,12,0,0">
