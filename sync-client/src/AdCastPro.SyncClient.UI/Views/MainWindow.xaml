                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Servis sagligi kartlari — ikon + sinyal gostergeli -->
                            <UniformGrid Grid.Row="3" Columns="4" Margin="0,8,0,2">
                                <!-- Senkronizasyon Servisi -->
                                <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="13,12" Margin="0,0,8,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="9" Background="#10241A" BorderBrush="#1B5E3A" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,11,0">
                                            <iconPacks:PackIconLucide Kind="RefreshCw" Width="16" Height="16" Foreground="{StaticResource StatusGreen}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="SENKRONİZASYON SERVİSİ" Style="{StaticResource Muted}" FontSize="9.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource StatusGreen}" VerticalAlignment="Center" Margin="0,0,7,0"><Ellipse.Effect><DropShadowEffect Color="#19C37D" BlurRadius="7" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect></Ellipse>
                                                <TextBlock Text="{Binding ServiceStatusText}" Foreground="{StaticResource FgPrimary}" FontWeight="Bold" FontSize="14"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="6,0,0,2">
                                            <Rectangle Width="3" Height="7" Fill="#19C37D" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Bottom"/>
                                            <Rectangle Width="3" Height="11" Fill="#19C37D" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Bottom"/>
                                            <Rectangle Width="3" Height="15" Fill="#19C37D" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Bottom"/>
                                            <Rectangle Width="3" Height="19" Fill="#19C37D" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <!-- İndirme Motoru -->
                                <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="13,12" Margin="0,0,8,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="9" Background="#10241A" BorderBrush="#1B5E3A" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,11,0">
                                            <iconPacks:PackIconLucide Kind="Download" Width="16" Height="16" Foreground="{StaticResource StatusGreen}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="İNDİRME MOTORU" Style="{StaticResource Muted}" FontSize="9.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource StatusGreen}" VerticalAlignment="Center" Margin="0,0,7,0"><Ellipse.Effect><DropShadowEffect Color="#19C37D" BlurRadius="7" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect></Ellipse>
                                                <TextBlock Text="{Binding EngineStatusText}" Foreground="{StaticResource FgPrimary}" FontWeight="Bold" FontSize="14"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="6,0,0,2">
                                            <Rectangle Width="3" Height="7" Fill="#19C37D" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Bottom"/>
                                            <Rectangle Width="3" Height="11" Fill="#19C37D" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Bottom"/>
                                            <Rectangle Width="3" Height="15" Fill="#19C37D" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Bottom"/>
                                            <Rectangle Width="3" Height="19" Fill="#19C37D" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <!-- Sunucu Bağlantısı -->
                                <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="13,12" Margin="0,0,8,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="9" Background="#0E1E2E" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,11,0">
                                            <Border.BorderBrush><SolidColorBrush Color="{Binding ConnStatusColor}" Opacity="0.5"/></Border.BorderBrush>
                                            <iconPacks:PackIconLucide Kind="SatelliteDish" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"><iconPacks:PackIconLucide.Foreground><SolidColorBrush Color="{Binding ConnStatusColor}"/></iconPacks:PackIconLucide.Foreground></iconPacks:PackIconLucide>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="SUNUCU BAĞLANTISI" Style="{StaticResource Muted}" FontSize="9.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0"><Ellipse.Fill><SolidColorBrush Color="{Binding ConnStatusColor}"/></Ellipse.Fill><Ellipse.Effect><DropShadowEffect Color="#19C37D" BlurRadius="7" ShadowDepth="0" Opacity="0.85"/></Ellipse.Effect></Ellipse>
                                                <TextBlock Text="{Binding ConnStatusText}" Foreground="{StaticResource FgPrimary}" FontWeight="Bold" FontSize="14"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="6,0,0,2">
                                            <Rectangle Width="3" Height="7" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Bottom"><Rectangle.Fill><SolidColorBrush Color="{Binding ConnStatusColor}"/></Rectangle.Fill></Rectangle>
                                            <Rectangle Width="3" Height="11" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Bottom"><Rectangle.Fill><SolidColorBrush Color="{Binding ConnStatusColor}"/></Rectangle.Fill></Rectangle>
                                            <Rectangle Width="3" Height="15" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Bottom"><Rectangle.Fill><SolidColorBrush Color="{Binding ConnStatusColor}"/></Rectangle.Fill></Rectangle>
                                            <Rectangle Width="3" Height="19" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Bottom"><Rectangle.Fill><SolidColorBrush Color="{Binding ConnStatusColor}"/></Rectangle.Fill></Rectangle>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <!-- Çalışma Süresi -->
                                <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="13,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="9" Background="#191428" BorderBrush="#332A52" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,11,0">
                                            <iconPacks:PackIconLucide Kind="Clock" Width="16" Height="16" Foreground="#A78BFA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="ÇALIŞMA SÜRESİ" Style="{StaticResource Muted}" FontSize="9.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding UptimeText}" Foreground="{StaticResource FgPrimary}" FontWeight="Bold" FontSize="14" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </UniformGrid>

                            <!-- Senkronizasyon & Ag bilgileri + Son olaylar -->
                            <Grid Grid.Row="4" Margin="0,8,0,0" VerticalAlignment="Top">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Width="20" Height="20" CornerRadius="5" Background="#11283C" Margin="0,0,8,0"><iconPacks:PackIconLucide Kind="Globe" Width="11" Height="11" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                            <TextBlock Text="Senkronizasyon &amp; Ağ" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <!-- Sol kolon -->
                                            <StackPanel Grid.Column="0">
                                                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Sunucu" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding ServerAddress}" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></Grid>
                                                <Border Height="1" Background="#13202F" Margin="0,2"/>
                                                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Bağlantı" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding ConnStatusText}" FontWeight="SemiBold"><TextBlock.Foreground><SolidColorBrush Color="{Binding ConnStatusColor}"/></TextBlock.Foreground></TextBlock></Grid>
                                                <Border Height="1" Background="#13202F" Margin="0,2"/>
                                                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Son senkronizasyon" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding LastSyncTime}" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold"/></Grid>
                                                <Border Height="1" Background="#13202F" Margin="0,2"/>
                                                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Son kontrol" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding LastCheckTime}" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold"/></Grid>
                                            </StackPanel>
                                            <!-- Sağ kolon -->
                                            <StackPanel Grid.Column="2">
                                                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Tarama aralığı" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding PollIntervalText}" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold"/></Grid>
                                                <Border Height="1" Background="#13202F" Margin="0,2"/>
                                                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Heartbeat" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding HeartbeatText}" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold"/></Grid>
                                                <Border Height="1" Background="#13202F" Margin="0,2"/>
                                                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Son hata" Style="{StaticResource Muted}"/>
                                                    <Border Grid.Column="1" CornerRadius="6" Padding="7,1" Background="#0C1726" BorderBrush="#1B5E3A" BorderThickness="1"><TextBlock Text="{Binding LastErrorText}" Foreground="{StaticResource StatusGreen}" FontWeight="Bold" FontSize="11"/></Border></Grid>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="20" Height="20" CornerRadius="5" Background="#0B1B14" Margin="0,0,8,0"><iconPacks:PackIconLucide Kind="Terminal" Width="11" Height="11" Foreground="{StaticResource StatusGreen}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                <TextBlock Text="Son Olaylar" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource StatusGreen}" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse.Effect><DropShadowEffect Color="#19C37D" BlurRadius="7" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect></Ellipse>
                                        </Grid>
                                        <Border Background="#060A12" CornerRadius="8" Height="92" Padding="11,9" BorderBrush="#0E2118" BorderThickness="1">
                                            <ItemsControl ItemsSource="{Binding ConsoleLines}">
                                                <ItemsControl.Template>
                                                    <ControlTemplate>
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                                                    </ControlTemplate>
                                                </ItemsControl.Template>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Foreground="#86EFAC" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" Margin="0,1.5">
                                                            <TextBlock.Effect><DropShadowEffect Color="#22C55E" BlurRadius="5" ShadowDepth="0" Opacity="0.35"/></TextBlock.Effect>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionToVis}, ConverterParameter=raporlar}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Raporlar — Operasyonel Özet" Style="{StaticResource CardTitle}"/>
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Padding="15,7" Command="{Binding RefreshCommand}">
                                    <StackPanel Orientation="Horizontal"><iconPacks:PackIconLucide Kind="RotateCw" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="Yenile" FontWeight="SemiBold"/></StackPanel>
                                </Button>
                            </Grid>

                            <!-- Özet istatistik kartları (gradyan, premium) -->
                            <UniformGrid Grid.Row="1" Columns="4" Margin="0,6,0,16">
                                <Border CornerRadius="12" Padding="15,13" Margin="0,0,11,0" BorderThickness="1">
                                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#17243C" Offset="0"/><GradientStop Color="#0E1626" Offset="1"/></LinearGradientBrush></Border.Background>
                                    <Border.BorderBrush><SolidColorBrush Color="#27344C"/></Border.BorderBrush>
                                    <StackPanel>
                                        <TextBlock Text="TOPLAM İNDİRİLEN" Foreground="{StaticResource FgMuted}" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,6,0,0"><Run Text="{Binding ReportTotalFiles}" Foreground="{StaticResource FgPrimary}" FontSize="23" FontWeight="Bold"/><Run Text=" dosya" Foreground="{StaticResource FgMuted}" FontSize="12"/></TextBlock>
                                        <TextBlock Text="{Binding ReportTotalSize}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="12" Padding="15,13" Margin="0,0,11,0" BorderThickness="1">
                                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#13261D" Offset="0"/><GradientStop Color="#0E1626" Offset="1"/></LinearGradientBrush></Border.Background>
                                    <Border.BorderBrush><SolidColorBrush Color="#1F3A2C"/></Border.BorderBrush>
                                    <StackPanel>
                                        <TextBlock Text="BUGÜN İNDİRİLEN" Foreground="{StaticResource FgMuted}" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,6,0,0"><Run Text="{Binding ReportTodayFiles}" Foreground="{StaticResource StatusGreen}" FontSize="23" FontWeight="Bold"/><Run Text=" dosya" Foreground="{StaticResource FgMuted}" FontSize="12"/></TextBlock>
                                        <TextBlock Text="{Binding ReportTodaySize}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="12" Padding="15,13" Margin="0,0,11,0" BorderThickness="1">
                                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#17243C" Offset="0"/><GradientStop Color="#0E1626" Offset="1"/></LinearGradientBrush></Border.Background>
                                    <Border.BorderBrush><SolidColorBrush Color="#27344C"/></Border.BorderBrush>
                                    <StackPanel>
                                        <TextBlock Text="HAZIR YAYIN KUŞAĞI" Foreground="{StaticResource FgMuted}" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ReportSlotsReady}" Foreground="{StaticResource FgPrimary}" FontSize="23" FontWeight="Bold" Margin="0,6,0,0"/>
                                        <TextBlock Text="hazır / toplam" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="12" Padding="15,13" BorderThickness="1">
                                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#17243C" Offset="0"/><GradientStop Color="#0E1626" Offset="1"/></LinearGradientBrush></Border.Background>
                                    <Border.BorderBrush><SolidColorBrush Color="#27344C"/></Border.BorderBrush>
                                    <StackPanel>
                                        <TextBlock Text="SON SENKRONİZASYON" Foreground="{StaticResource FgMuted}" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ReportLastSync}" Foreground="{StaticResource FgPrimary}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Yayın Kuşağı Durumu -->
                            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                                <TextBlock Text="YAYIN KUŞAĞI DURUMU" Foreground="{StaticResource FgMuted}" FontWeight="Bold" FontSize="11" Margin="0,0,0,7"/>
                                <Border CornerRadius="10" BorderThickness="1" Padding="14,6">
                                    <Border.Background><SolidColorBrush Color="#0E1626"/></Border.Background>
                                    <Border.BorderBrush><SolidColorBrush Color="#1E293B"/></Border.BorderBrush>
                                    <ItemsControl ItemsSource="{Binding Slots}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource FgMuted}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource FgPrimary}" FontSize="13" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="2" CornerRadius="6" Padding="9,2.5" VerticalAlignment="Center" Background="#16202F">
                                                        <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="10"><TextBlock.Foreground><SolidColorBrush Color="{Binding StatusColor}"/></TextBlock.Foreground></TextBlock>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>

                            <!-- İndirilen Dosyalar (alanı doldurur) -->
                            <Grid Grid.Row="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="İNDİRİLEN DOSYALAR" Foreground="{StaticResource FgMuted}" FontWeight="Bold" FontSize="11" Margin="0,0,0,7"/>
                                <Grid Grid.Row="1" Margin="2,0,2,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Dosya" Style="{StaticResource Muted}" FontSize="10.5"/>
                                    <TextBlock Grid.Column="1" Text="Boyut" Style="{StaticResource Muted}" FontSize="10.5"/>
                                    <TextBlock Grid.Column="2" Text="Tarih" Style="{StaticResource Muted}" FontSize="10.5"/>
                                    <TextBlock Grid.Column="3" Text="Durum" Style="{StaticResource Muted}" FontSize="10.5"/>
                                </Grid>
                                <Border Grid.Row="2" Background="{StaticResource BorderColor}" Height="1"/>
                                <Grid Grid.Row="3">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding RecentDownloads}" VerticalAlignment="Top" Margin="2,2,2,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <iconPacks:PackIconLucide Kind="{Binding Icon, Converter={StaticResource LucideKind}}" Width="14" Height="14" Foreground="{StaticResource FgMuted}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                        <TextBlock Text="{Binding FileName}" Foreground="{StaticResource FgPrimary}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Size}" Style="{StaticResource Muted}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Date}" Style="{StaticResource Muted}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding StatusText}" Foreground="{StaticResource StatusGreen}" FontSize="12.5"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </ScrollViewer>
                                    <!-- Premium empty state — alanı doldurur, merkezde -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RecentDownloads.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border Width="66" Height="66" CornerRadius="33" HorizontalAlignment="Center" Background="#13203A" BorderBrush="#243149" BorderThickness="1">
                                            <iconPacks:PackIconLucide Kind="Inbox" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource FgMuted}"/>
                                        </Border>
                                        <TextBlock Text="Henüz dosya indirilmedi" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="13.5" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                                        <TextBlock Text="İlk senkronizasyonda indirilen dosyalar burada listelenir." Foreground="{StaticResource FgDim}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <Button Grid.Row="4" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="15,9" Click="OnLogs">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="Wrench" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Teknik Günlükler (Sorun Giderme)" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionToVis}, ConverterParameter=ayarlar}">
                        <Grid DataContext="{Binding SettingsVm}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                            <TextBlock Text="Ayarlar" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="İçerik klasörleri — her tür kendi klasörüne indirilir. Klasör seçmek için klasör simgesini kullanın." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <!-- Klasorler: 2 sutunlu kompakt izgara (scroll yok) -->
                            <UniformGrid Columns="2">
                                <!-- 1 -->
                                <StackPanel Margin="0,0,12,12">
                                    <TextBlock Text="Haber" Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,3"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7" Height="34"><TextBox Text="{Binding NewsFolder, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="9,0" FontSize="12"/></Border>
                                        <Button Grid.Column="1" ToolTip="Gözat" Width="38" Height="34" Margin="6,0,0,0" Style="{StaticResource IconBrowseButton}" Padding="0" Command="{Binding BrowseNewsCommand}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- 2 -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Reklam" Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,3"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7" Height="34"><TextBox Text="{Binding AdsFolder, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="9,0" FontSize="12"/></Border>
                                        <Button Grid.Column="1" ToolTip="Gözat" Width="38" Height="34" Margin="6,0,0,0" Style="{StaticResource IconBrowseButton}" Padding="0" Command="{Binding BrowseAdsCommand}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- 3 -->
                                <StackPanel Margin="0,0,12,12">
                                    <TextBlock Text="Medya Planı" Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,3"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7" Height="34"><TextBox Text="{Binding MediaPlansFolder, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="9,0" FontSize="12"/></Border>
                                        <Button Grid.Column="1" ToolTip="Gözat" Width="38" Height="34" Margin="6,0,0,0" Style="{StaticResource IconBrowseButton}" Padding="0" Command="{Binding BrowseMediaPlansCommand}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- 4 -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Sponsor" Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,3"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7" Height="34"><TextBox Text="{Binding SponsorsFolder, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="9,0" FontSize="12"/></Border>
                                        <Button Grid.Column="1" ToolTip="Gözat" Width="38" Height="34" Margin="6,0,0,0" Style="{StaticResource IconBrowseButton}" Padding="0" Command="{Binding BrowseSponsorsCommand}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- 5 -->
                                <StackPanel Margin="0,0,12,12">
                                    <TextBlock Text="Acil Anons" Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,3"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7" Height="34"><TextBox Text="{Binding EmergencyFolder, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="9,0" FontSize="12"/></Border>
                                        <Button Grid.Column="1" ToolTip="Gözat" Width="38" Height="34" Margin="6,0,0,0" Style="{StaticResource IconBrowseButton}" Padding="0" Command="{Binding BrowseEmergencyCommand}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- 6 -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Tanıtım (Promo)" Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,3"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7" Height="34"><TextBox Text="{Binding PromoFolder, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="9,0" FontSize="12"/></Border>
                                        <Button Grid.Column="1" ToolTip="Gözat" Width="38" Height="34" Margin="6,0,0,0" Style="{StaticResource IconBrowseButton}" Padding="0" Command="{Binding BrowsePromoCommand}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- 7 -->
                                <StackPanel Margin="0,0,12,12">
                                    <TextBlock Text="Cıngıl (Jingle)" Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,3"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7" Height="34"><TextBox Text="{Binding JingleFolder, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="9,0" FontSize="12"/></Border>
                                        <Button Grid.Column="1" ToolTip="Gözat" Width="38" Height="34" Margin="6,0,0,0" Style="{StaticResource IconBrowseButton}" Padding="0" Command="{Binding BrowseJingleCommand}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- 8 -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Bölgesel İçerik" Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,3"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7" Height="34"><TextBox Text="{Binding RegionalFolder, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="9,0" FontSize="12"/></Border>
                                        <Button Grid.Column="1" ToolTip="Gözat" Width="38" Height="34" Margin="6,0,0,0" Style="{StaticResource IconBrowseButton}" Padding="0" Command="{Binding BrowseRegionalCommand}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- 9 -->
                                <StackPanel Margin="0,0,12,12">
                                    <TextBlock Text="Ulusal İçerik" Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,3"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7" Height="34"><TextBox Text="{Binding NationalFolder, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="9,0" FontSize="12"/></Border>
                                        <Button Grid.Column="1" ToolTip="Gözat" Width="38" Height="34" Margin="6,0,0,0" Style="{StaticResource IconBrowseButton}" Padding="0" Command="{Binding BrowseNationalCommand}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- 10 -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Arşiv" Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,3"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7" Height="34"><TextBox Text="{Binding ArchiveFolder, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="9,0" FontSize="12"/></Border>
                                        <Button Grid.Column="1" ToolTip="Gözat" Width="38" Height="34" Margin="6,0,0,0" Style="{StaticResource IconBrowseButton}" Padding="0" Command="{Binding BrowseArchiveCommand}"/>
                                    </Grid>
                                </StackPanel>
                                <!-- 11 -->
                                <StackPanel Margin="0,0,12,12">
                                    <TextBlock Text="Geçici Dosyalar" Foreground="{StaticResource FgMuted}" FontSize="11" Margin="0,0,0,3"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7" Height="34"><TextBox Text="{Binding TempFolder, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="9,0" FontSize="12"/></Border>
                                        <Button Grid.Column="1" ToolTip="Gözat" Width="38" Height="34" Margin="6,0,0,0" Style="{StaticResource IconBrowseButton}" Padding="0" Command="{Binding BrowseTempCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </UniformGrid>
                            </StackPanel>

                            <!-- Genel ayarlar + Kaydet — panelin alt aksiyon bandı -->
                            <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                <Border Background="{StaticResource BorderColor}" Height="1" Margin="0,0,0,16"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Tarama aralığı (sn):" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="7" Height="34" Width="80"><TextBox Text="{Binding PollIntervalSeconds}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="9,0" FontSize="12.5"/></Border>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Content="Windows ile birlikte başlat" Foreground="{StaticResource FgPrimary}" IsChecked="{Binding AutoStartWithWindows}" VerticalAlignment="Center" Margin="22,0,0,0"/>
                                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Padding="30,10" Command="{Binding SaveCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="Save" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Kaydet" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ====== DESTEK ====== -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionToVis}, ConverterParameter=destek}">
                        <Grid DataContext="{Binding SupportVm}" MaxWidth="1040" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Sol kolon: Form -->
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Destek Talebi" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Bir sorununuz mu var? Aşağıdaki formu doldurun; ekibimiz en kısa sürede sizinle iletişime geçecektir." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <!-- Radyo Bilgileri (otomatik, salt-okunur) -->
                            <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <iconPacks:PackIconLucide Kind="Radio" Width="13" Height="13" Foreground="{StaticResource FgMuted}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="RADYO BİLGİLERİ (otomatik)" Style="{StaticResource Muted}" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,12,8"><TextBlock Text="Radyo Adı" Foreground="{StaticResource FgDim}" FontSize="11"/><TextBlock Text="{Binding RadioName}" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="13"/></StackPanel>
                                        <StackPanel Margin="0,0,0,8"><TextBlock Text="Frekans" Foreground="{StaticResource FgDim}" FontSize="11"/><TextBlock Text="{Binding Frequency}" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="13"/></StackPanel>
                                        <StackPanel Margin="0,0,12,0"><TextBlock Text="Bölge" Foreground="{StaticResource FgDim}" FontSize="11"/><TextBlock Text="{Binding Region}" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="13"/></StackPanel>
                                        <StackPanel><TextBlock Text="İl" Foreground="{StaticResource FgDim}" FontSize="11"/><TextBlock Text="{Binding City}" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="13"/></StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Manuel alanlar -->
                            <TextBlock Text="Ad Soyad *" Style="{StaticResource Muted}" Margin="0,2,0,4"/>
                            <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Height="40" Margin="0,0,0,12">
                                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="10,0"/>
                            </Border>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Telefon *" Style="{StaticResource Muted}" Margin="0,2,0,4"/>
                                    <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Height="40">
                                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="10,0"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="E-posta *" Style="{StaticResource Muted}" Margin="0,2,0,4"/>
                                    <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Height="40">
                                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" VerticalContentAlignment="Center" Padding="10,0"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Destek Mesajı *" Style="{StaticResource Muted}" Margin="0,2,0,4"/>
                            <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Height="130" Margin="0,0,0,4">
                                <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource FgPrimary}" CaretBrush="{StaticResource FgPrimary}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Padding="10,8"/>
                            </Border>
                            <TextBlock Text="En az 10 karakter." Foreground="{StaticResource FgDim}" FontSize="11" Margin="0,0,0,8"/>

                            <!-- Durum mesaji -->
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12.5" Margin="0,2,0,10"
                                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource StatusGreen}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource StatusRed}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button Command="{Binding SubmitCommand}" HorizontalAlignment="Left" Padding="24,11">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Content" Value="Destek Talebi Gönder"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSubmitting}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Content" Value="Gönderiliyor…"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            </StackPanel>

                            <!-- Sağ kolon: Destek Süreci + bilgi notları -->
                            <Border Grid.Column="1" CornerRadius="14" Padding="20,20" BorderThickness="1" VerticalAlignment="Stretch">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                                        <GradientStop Color="#13203A" Offset="0"/>
                                        <GradientStop Color="#0C1322" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush><SolidColorBrush Color="#243149"/></Border.BorderBrush>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                        <iconPacks:PackIconLucide Kind="LifeBuoy" Width="13" Height="13" Foreground="{StaticResource FgMuted}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="DESTEK SÜRECİ" Foreground="{StaticResource FgMuted}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="15" Background="#1E2B45" BorderBrush="{StaticResource BrandRed}" BorderThickness="1.3" VerticalAlignment="Top"><TextBlock Text="1" Foreground="{StaticResource FgPrimary}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0"><TextBlock Text="Talebinizi gönderin" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Formu doldurup gönderin; radyo bilgileriniz otomatik eklenir." Foreground="{StaticResource FgMuted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel>
                                    </Grid>
                                    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="15" Background="#1E2B45" BorderBrush="#3A4A66" BorderThickness="1.3" VerticalAlignment="Top"><TextBlock Text="2" Foreground="{StaticResource FgPrimary}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0"><TextBlock Text="Ekibimiz incelesin" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Destek ekibimiz talebinizi değerlendirir." Foreground="{StaticResource FgMuted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel>
                                    </Grid>
                                    <Grid Margin="0,0,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="15" Background="#1E2B45" BorderBrush="#3A4A66" BorderThickness="1.3" VerticalAlignment="Top"><TextBlock Text="3" Foreground="{StaticResource FgPrimary}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0"><TextBlock Text="Sizinle iletişime geçilsin" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Verdiğiniz telefon/e-posta üzerinden dönüş yapılır." Foreground="{StaticResource FgMuted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel>
                                    </Grid>

                                    <Border Background="{StaticResource BorderColor}" Height="1" Margin="0,18,0,14"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <iconPacks:PackIconLucide Kind="Clock" Width="13" Height="13" Foreground="{StaticResource FgMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Ortalama yanıt süresi: 1 iş günü" Foreground="{StaticResource FgMuted}" FontSize="11.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="Lock" Width="13" Height="13" Foreground="{StaticResource FgMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Bilgileriniz yalnızca destek amacıyla kullanılır" Foreground="{StaticResource FgMuted}" FontSize="11.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Visibility="{Binding SelectedSection, Converter={StaticResource SectionToVis}, ConverterParameter=guncelleme}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Başlık şeridi -->
                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="11" Background="#10241A" BorderBrush="#1B5E3A" BorderThickness="1" Margin="0,0,14,0">
                                    <iconPacks:PackIconLucide Kind="RefreshCw" Width="20" Height="20" Foreground="{StaticResource StatusGreen}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Güncellemeler" Style="{StaticResource CardTitle}" Margin="0"/>
                                    <TextBlock Text="Sistem güncel ve otomatik güncelleme etkin" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" CornerRadius="10" Padding="14,7" VerticalAlignment="Center" Background="#10311F" BorderBrush="#1B7A4E" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="ShieldCheck" Width="18" Height="18" Foreground="{StaticResource StatusGreen}" VerticalAlignment="Center"/>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding UpdateStatusText}" Foreground="{StaticResource StatusGreen}" FontWeight="Bold" FontSize="12.5"/>
                                            <TextBlock Text="{Binding UpdateStatusDetail}" Style="{StaticResource Muted}" FontSize="10.5"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 1. sıra: Sürüm Durumu + Otomatik Güncelleme -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>

                            <!-- Sürüm Durumu -->
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="SÜRÜM DURUMU" Style="{StaticResource Muted}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                                    <Grid Grid.Row="1" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AppVersion}" Foreground="{StaticResource FgPrimary}" FontWeight="Bold" FontSize="34"/>
                                            <TextBlock Text="Mevcut sürüm" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                            <TextBlock Margin="0,14,0,0"><Run Text="Son kontrol: " Foreground="{StaticResource FgMuted}" FontSize="11.5"/><Run Text="{Binding LastUpdateCheckShort}" Foreground="{StaticResource StatusGreen}" FontWeight="SemiBold" FontSize="11.5"/></TextBlock>
                                        </StackPanel>
                                        <Grid Grid.Column="1" Width="148" Height="148">
                                            <ctl:DonutProgress Percent="{Binding UpdateReadinessPercent}" HideValue="True">
                                                <ctl:DonutProgress.RingColor><SolidColorBrush Color="#19C37D"/></ctl:DonutProgress.RingColor>
                                            </ctl:DonutProgress>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <iconPacks:PackIconLucide Kind="ShieldCheck" Width="34" Height="34" Foreground="{StaticResource StatusGreen}" HorizontalAlignment="Center">
                                                    <iconPacks:PackIconLucide.Effect><DropShadowEffect Color="#19C37D" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/></iconPacks:PackIconLucide.Effect>
                                                </iconPacks:PackIconLucide>
                                                <TextBlock Text="{Binding UpdateStatusText}" Foreground="{StaticResource StatusGreen}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                    <Button Grid.Row="2" Style="{StaticResource GhostButton}" Margin="0,14,0,0" Command="{Binding CheckUpdateCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="RotateCw" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Güncellemeyi Kontrol Et" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Otomatik Güncelleme -->
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="OTOMATİK GÜNCELLEME" Style="{StaticResource Muted}" FontWeight="Bold" FontSize="11" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Otomatik güncelleme" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="13.5"/>
                                            <TextBlock Text="Yeni güncellemeler otomatik olarak indirilir ve yüklenir." Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <ToggleButton Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoUpdateEnabled}"/>
                                            <TextBlock Text="Etkin" Foreground="{StaticResource StatusGreen}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="9,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="#16243A" Margin="0,12"/>

                                    <!-- Ayar satırları -->
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <iconPacks:PackIconLucide Style="{StaticResource MetricIcon}" Kind="GitBranch" Margin="0,0,9,0"/>
                                        <TextBlock Grid.Column="1" Text="Güncelleme kanalı" Foreground="{StaticResource FgPrimary}" FontSize="12.5" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding UpdateChannel}" Foreground="{StaticResource FgMuted}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                        <iconPacks:PackIconLucide Grid.Column="3" Kind="ChevronDown" Width="13" Height="13" Foreground="{StaticResource FgDim}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <iconPacks:PackIconLucide Style="{StaticResource MetricIcon}" Kind="Wifi" Margin="0,0,9,0"/>
                                        <TextBlock Grid.Column="1" Text="İndirme politikası" Foreground="{StaticResource FgPrimary}" FontSize="12.5" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DownloadPolicy}" Foreground="{StaticResource FgMuted}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                        <iconPacks:PackIconLucide Grid.Column="3" Kind="ChevronDown" Width="13" Height="13" Foreground="{StaticResource FgDim}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <iconPacks:PackIconLucide Style="{StaticResource MetricIcon}" Kind="Calendar" Margin="0,0,9,0"/>
                                        <TextBlock Grid.Column="1" Text="Güncelleme zamanlaması" Foreground="{StaticResource FgPrimary}" FontSize="12.5" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding UpdateSchedule}" Foreground="{StaticResource FgMuted}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                        <iconPacks:PackIconLucide Grid.Column="3" Kind="ChevronDown" Width="13" Height="13" Foreground="{StaticResource FgDim}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>

                                    <Border Height="1" Background="#16243A" Margin="0,10"/>

                                    <!-- Bilgi satırları -->
                                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Son güncelleme kontrolü" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding LastUpdateCheckText}" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold"/></Grid>
                                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Son başarılı güncelleme" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding LastSuccessfulUpdateText}" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold"/></Grid>
                                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Son güncelleme sonucu" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding LastUpdateResultText}" Foreground="{StaticResource StatusGreen}" FontWeight="Bold"/></Grid>
                                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Sonraki kontrol" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding NextUpdateCheckText}" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold"/></Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 2. sıra: Güncelleme Geçmişi + Sürüm Notları -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                            <!-- Güncelleme Geçmişi -->
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                        <iconPacks:PackIconLucide Style="{StaticResource CardHeaderIcon}" Kind="History"/>
                                        <TextBlock Style="{StaticResource CardTitleInline}" Text="GÜNCELLEME GEÇMİŞİ"/>
                                    </StackPanel>
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding UpdateHistory}" VerticalAlignment="Top">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,5">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Border Width="22" Height="22" CornerRadius="11" Margin="0,0,11,0" VerticalAlignment="Center" BorderThickness="1">
                                                        <Border.Background><SolidColorBrush Color="{Binding Color}" Opacity="0.16"/></Border.Background>
                                                        <Border.BorderBrush><SolidColorBrush Color="{Binding Color}" Opacity="0.5"/></Border.BorderBrush>
                                                        <iconPacks:PackIconLucide Kind="Check" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"><iconPacks:PackIconLucide.Foreground><SolidColorBrush Color="{Binding Color}"/></iconPacks:PackIconLucide.Foreground></iconPacks:PackIconLucide>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,8,0">
                                                        <iconPacks:PackIconLucide Kind="Calendar" Width="11" Height="11" Foreground="{StaticResource FgDim}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding Time}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="3" CornerRadius="6" Padding="8,2" VerticalAlignment="Center" BorderThickness="1">
                                                        <Border.Background><SolidColorBrush Color="{Binding Color}" Opacity="0.12"/></Border.Background>
                                                        <Border.BorderBrush><SolidColorBrush Color="{Binding Color}" Opacity="0.4"/></Border.BorderBrush>
                                                        <TextBlock Text="{Binding Mark}" FontSize="10.5" FontWeight="Bold"><TextBlock.Foreground><SolidColorBrush Color="{Binding Color}"/></TextBlock.Foreground></TextBlock>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Grid.Row="2" Style="{StaticResource GhostButton}" Margin="0,10,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="History" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Tüm geçmişi görüntüle" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Sürüm Notları -->
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                        <iconPacks:PackIconLucide Style="{StaticResource CardHeaderIcon}" Kind="FileText"/>
                                        <TextBlock Style="{StaticResource CardTitleInline}" Text="SÜRÜM NOTLARI"/>
                                    </StackPanel>
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ReleaseNotes}" VerticalAlignment="Top">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Border Width="22" Height="22" CornerRadius="11" Margin="0,1,11,0" VerticalAlignment="Top" Background="#10241A" BorderBrush="#1B5E3A" BorderThickness="1">
                                                        <iconPacks:PackIconLucide Kind="Check" Width="12" Height="12" Foreground="{StaticResource StatusGreen}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="12.5"/>
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Grid.Row="2" Style="{StaticResource GhostButton}" Margin="0,10,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="FileText" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Detayları görüntüle" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Border Style="{StaticResource Card}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionToVis}, ConverterParameter=hakkinda}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="700" Margin="0,8,0,8">
                            <!-- Logo -->
                            <Image Source="/AdCastPro.SyncClient;component/Assets/adcastpro-logo.png"
                                   Stretch="Uniform" MaxHeight="126" HorizontalAlignment="Center" Margin="0,0,0,6"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="Yayın Senkronizasyon İstemcisi" Style="{StaticResource Muted}" HorizontalAlignment="Center" FontSize="13"/>
                            <TextBlock Text="Planla. Yayınla. Raporla." Foreground="{StaticResource BrandRed}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="13"/>

                            <!-- Aksan cizgisi -->
                            <Border Height="2" Width="120" CornerRadius="1" Margin="0,16,0,16" HorizontalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00E11D48" Offset="0"/>
                                        <GradientStop Color="#E11D48" Offset="0.5"/>
                                        <GradientStop Color="#00E11D48" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Profesyonel aciklama -->
                            <TextBlock Foreground="{StaticResource FgPrimary}" FontSize="13.5" TextAlignment="Center" TextWrapping="Wrap" LineHeight="22"
                                       Text="AdCast Pro, radyo istasyonları için geliştirilmiş profesyonel bir yayın senkronizasyon ve içerik dağıtım platformudur. Haber bültenleri, reklamlar, cıngıllar, tanıtımlar ve sponsor içeriklerini merkezi sunucudan otomatik olarak indirir; yayın kuşaklarına göre düzenler ve istasyonunuzun her an yayına hazır olmasını sağlar."/>
                            <TextBlock Foreground="{StaticResource FgMuted}" FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0"
                                       Text="Uçtan uca güvenli dosya doğrulama, gerçek zamanlı sistem izleme ve kesintisiz otomatik güncelleme ile yayın sürekliliğinizi güvence altına alır."/>

                            <!-- Ozellikler -->
                            <UniformGrid Columns="2" Margin="0,18,0,4">
                                <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,6,8">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="RefreshCw" Width="16" Height="16" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel><TextBlock Text="Otomatik Senkronizasyon" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="Merkezden gerçek zamanlı içerik" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="6,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="Radio" Width="16" Height="16" Foreground="{StaticResource BrandRed}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel><TextBlock Text="Yayın Kuşağı Yönetimi" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="Günlük plana göre hazırlık" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="ShieldCheck" Width="16" Height="16" Foreground="{StaticResource StatusGreen}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel><TextBlock Text="Güvenli Doğrulama" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="Bütünlük ve format kontrolü" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="Activity" Width="16" Height="16" Foreground="#A78BFA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel><TextBlock Text="Sistem İzleme" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="CPU, bellek, disk ve sağlık" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Alt bilgi -->
                            <Border Background="{StaticResource BorderColor}" Height="1" Margin="0,18,0,12"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Sürüm 1.0.0.0" Style="{StaticResource Muted}" FontSize="12"/>
                                <TextBlock Text="  •  " Foreground="{StaticResource FgDim}" FontSize="12"/>
                                <TextBlock Text="© 2025 AdCast Pro" Style="{StaticResource Muted}" FontSize="12"/>
                                <TextBlock Text="  •  " Foreground="{StaticResource FgDim}" FontSize="12"/>
                                <TextBlock Text="Tüm hakları saklıdır." Foreground="{StaticResource FgDim}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="24,9">
                <StackPanel Orientation="Horizontal">
                    <TextBlock><Run Text="Durum: " Foreground="{StaticResource FgMuted}" FontSize="12"/><Run Text="{Binding ServiceStatusText}" Foreground="{StaticResource StatusGreen}" FontSize="12" FontWeight="SemiBold"/></TextBlock>
                    <TextBlock Margin="24,0,0,0"><Run Text="Bağlantı: " Foreground="{StaticResource FgMuted}" FontSize="12"/><Run Text="{Binding ServerAddress}" Foreground="{StaticResource FgPrimary}" FontSize="12"/></TextBlock>
                    <TextBlock Margin="24,0,0,0"><Run Text="Kullanıcı: " Foreground="{StaticResource FgMuted}" FontSize="12"/><Run Text="{Binding ConnUserName}" Foreground="{StaticResource FgPrimary}" FontSize="12"/></TextBlock>
                    <TextBlock Margin="24,0,0,0"><Run Text="İstasyon: " Foreground="{StaticResource FgMuted}" FontSize="12"/><Run Text="{Binding StationName}" Foreground="{StaticResource FgPrimary}" FontSize="12"/></TextBlock>
                    <TextBlock Margin="24,0,0,0"><Run Text="Bölge: " Foreground="{StaticResource FgMuted}" FontSize="12"/><Run Text="{Binding RegionName}" Foreground="{StaticResource FgPrimary}" FontSize="12"/></TextBlock>
                    <TextBlock Margin="24,0,0,0"><Run Text="İl: " Foreground="{StaticResource FgMuted}" FontSize="12"/><Run Text="{Binding ProvinceName}" Foreground="{StaticResource FgPrimary}" FontSize="12"/></TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
