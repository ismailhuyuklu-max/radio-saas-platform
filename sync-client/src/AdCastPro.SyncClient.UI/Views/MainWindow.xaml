<Window
    x:Class="AdCastPro.SyncClient.UI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:AdCastPro.SyncClient.UI.Controls"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Title="AdCast Pro Senkronizasyon İstemcisi"
    Icon="/AdCastPro.SyncClient;component/Assets/app.ico"
    Width="1200" Height="760" MinWidth="980" MinHeight="600"
    Background="{StaticResource BgDark}"
    FontFamily="{StaticResource UiFont}"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    ResizeMode="CanMinimize"
    Closing="OnClosing">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== SIDEBAR ===================== -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo (yuksek cozunurluk) + teknolojik saat + tarih -->
                <StackPanel Grid.Row="0" Margin="16,18,16,8">
                    <Image Source="/AdCastPro.SyncClient;component/Assets/adcastpro-logo.png"
                           Stretch="Uniform" MaxHeight="118" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <!-- Teknolojik saat (zarif, dengeli) -->
                    <Border Margin="0,12,0,0" CornerRadius="13" Padding="12,9" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                                <GradientStop Color="#13203A" Offset="0" />
                                <GradientStop Color="#0A0F1A" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3A2230" Offset="0" />
                                <GradientStop Color="#1B2840" Offset="0.5" />
                                <GradientStop Color="#3A2230" Offset="1" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect Color="#E11D48" BlurRadius="22" ShadowDepth="0" Opacity="0.14" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="{Binding ClockTime}" HorizontalAlignment="Center"
                                       FontFamily="Consolas" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#E11D48" BlurRadius="12" ShadowDepth="0" Opacity="0.6" />
                                </TextBlock.Effect>
                            </TextBlock>

                            <!-- Aksan cizgisi -->
                            <Border Height="1.5" Margin="18,6,18,5" CornerRadius="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00E11D48" Offset="0" />
                                        <GradientStop Color="#E11D48" Offset="0.5" />
                                        <GradientStop Color="#00E11D48" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <TextBlock Text="{Binding ClockDay}" HorizontalAlignment="Center"
                                       Foreground="{StaticResource BrandRed}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="{Binding ClockDate}" HorizontalAlignment="Center"
                                       Foreground="{StaticResource FgPrimary}" FontSize="11.5" FontWeight="SemiBold" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Nav -->
                <StackPanel Grid.Row="1" Margin="0,4,0,0">
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="House" Content="Özet" IsChecked="True"
                                 Command="{Binding NavigateCommand}" CommandParameter="ozet" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="ListMusic" Content="Yayın Listesi"
                                 Command="{Binding NavigateCommand}" CommandParameter="liste" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="Download" Content="İndirilen Dosyalar"
                                 Command="{Binding NavigateCommand}" CommandParameter="indirilen" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="Clock" Content="Yayın Kuşakları"
                                 Command="{Binding NavigateCommand}" CommandParameter="kusak" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="ChartColumn" Content="Raporlar"
                                 Command="{Binding NavigateCommand}" CommandParameter="raporlar" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="Settings" Content="Ayarlar"
                                 Command="{Binding NavigateCommand}" CommandParameter="ayarlar" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="Activity" Content="Servis Durumu"
                                 Command="{Binding NavigateCommand}" CommandParameter="servis" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="RefreshCw" Content="Güncellemeler"
                                 Command="{Binding NavigateCommand}" CommandParameter="guncelleme" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="LifeBuoy" Content="Destek"
                                 Command="{Binding NavigateCommand}" CommandParameter="destek" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="Info" Content="Hakkında"
                                 Command="{Binding NavigateCommand}" CommandParameter="hakkinda" />
                </StackPanel>

                <!-- Alt durum (kompakt + teknolojik) -->
                <StackPanel Grid.Row="2" Margin="14,2,14,10">
                    <Border CornerRadius="10" Padding="11,8" Margin="0,0,0,7" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0E1A2C" Offset="0" />
                                <GradientStop Color="#0A0F1A" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#1C2A40" />
                        </Border.BorderBrush>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{StaticResource StatusGreen}" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Ellipse.Effect><DropShadowEffect Color="#10B981" BlurRadius="10" ShadowDepth="0" Opacity="0.95" /></Ellipse.Effect>
                            </Ellipse>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="SİSTEM DURUMU" Foreground="{StaticResource FgMuted}" FontSize="9" FontWeight="Bold" />
                                <TextBlock Text="{Binding ServiceStatusText}" Foreground="{StaticResource StatusGreen}" FontWeight="Bold" FontSize="13" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Foreground="{StaticResource FgDim}" FontSize="10">
                        <Run Text="Sürüm 1.0.0.0" /><Run Text="  •  © 2025 AdCast Pro" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== MAIN ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Content ===== -->
            <Grid Grid.Row="1">
                <!-- ============ ÖZET (kartlar alana tam oturur, yanlarda boşluk yok, taşma yok) ============ -->
                <Grid Margin="14,6,14,10" VerticalAlignment="Stretch"
                            Visibility="{Binding SelectedSection, Converter={StaticResource SectionToVis}, ConverterParameter=ozet}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Üst sıra: 4 kart -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Bağlantı Durumu -->
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <iconPacks:PackIconLucide Style="{StaticResource CardHeaderIcon}" Kind="Link"/>
                                        <TextBlock Style="{StaticResource CardTitleInline}" Text="BAĞLANTI DURUMU"/>
                                    </StackPanel>
                                    <Image Source="{Binding RadioLogoUrl}" Stretch="Uniform" MaxHeight="46"
                                           HorizontalAlignment="Left" Margin="0,0,0,10"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Border CornerRadius="20" Padding="12,6" HorizontalAlignment="Left" Margin="0,0,0,14"
                                            Background="#0C1726" BorderThickness="1">
                                        <Border.BorderBrush><SolidColorBrush Color="{Binding ConnStatusColor}" Opacity="0.45"/></Border.BorderBrush>
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="13" Height="13" Margin="0,0,9,0" VerticalAlignment="Center">
                                                <Ellipse Width="13" Height="13" Opacity="0.30"><Ellipse.Fill><SolidColorBrush Color="{Binding ConnStatusColor}" /></Ellipse.Fill></Ellipse>
                                                <Ellipse Width="7" Height="7"><Ellipse.Fill><SolidColorBrush Color="{Binding ConnStatusColor}" /></Ellipse.Fill>
                                                    <Ellipse.Effect><DropShadowEffect Color="{Binding ConnStatusColor}" BlurRadius="9" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
                                                </Ellipse>
                                            </Grid>
                                            <TextBlock Text="{Binding ConnStatusText}" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center">
                                                <TextBlock.Foreground><SolidColorBrush Color="{Binding ConnStatusColor}" /></TextBlock.Foreground>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Sunucu: " Style="{StaticResource Muted}" Margin="0,2"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ServerAddress}" Style="{StaticResource ValueText}" Margin="0,2" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Kullanıcı: " Style="{StaticResource Muted}" Margin="0,2"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConnUserName}" Style="{StaticResource ValueText}" Margin="0,2"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="İstasyon: " Style="{StaticResource Muted}" Margin="0,2"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StationName}" Style="{StaticResource ValueText}" Margin="0,2"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Frekans: " Style="{StaticResource Muted}" Margin="0,2"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Frequency}" Style="{StaticResource ValueText}" Margin="0,2"/>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Bölge: " Style="{StaticResource Muted}" Margin="0,2"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RegionName}" Style="{StaticResource ValueText}" Margin="0,2"/>
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="İl: " Style="{StaticResource Muted}" Margin="0,2"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ProvinceName}" Style="{StaticResource ValueText}" Margin="0,2"/>
                                    </Grid>
                                    <Button Content="Bağlantıyı Test Et" Style="{StaticResource GhostButton}" Margin="0,14,0,0"
                                            Command="{Binding SyncNowCommand}" />
                                </StackPanel>
                            </Border>

                            <!-- Sistem Durumu -->
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,8,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <iconPacks:PackIconLucide Style="{StaticResource CardHeaderIcon}" Kind="Monitor"/>
                                        <TextBlock Style="{StaticResource CardTitleInline}" Text="SİSTEM DURUMU"/>
                                    </StackPanel>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Servis:" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" CornerRadius="6" Padding="8,2" Background="#0C1726" BorderThickness="1">
                                            <Border.BorderBrush><SolidColorBrush Color="#19C37D" Opacity="0.4"/></Border.BorderBrush>
                                            <TextBlock Text="{Binding ServiceStatusText}" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource StatusGreen}"/></Border></Grid>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Bağlantı:" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" CornerRadius="6" Padding="8,2" Background="#0C1726" BorderThickness="1">
                                            <Border.BorderBrush><SolidColorBrush Color="{Binding ConnStatusColor}" Opacity="0.4"/></Border.BorderBrush>
                                            <TextBlock Text="{Binding ConnStatusText}" FontWeight="Bold" FontSize="10.5"><TextBlock.Foreground><SolidColorBrush Color="{Binding ConnStatusColor}"/></TextBlock.Foreground></TextBlock></Border></Grid>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="İndirme Motoru:" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" CornerRadius="6" Padding="8,2" Background="#0C1726" BorderThickness="1">
                                            <Border.BorderBrush><SolidColorBrush Color="#19C37D" Opacity="0.4"/></Border.BorderBrush>
                                            <TextBlock Text="{Binding EngineStatusText}" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource StatusGreen}"/></Border></Grid>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Son Hata:" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" CornerRadius="6" Padding="8,2" Background="#0C1726" BorderThickness="1">
                                            <Border.BorderBrush><SolidColorBrush Color="#19C37D" Opacity="0.4"/></Border.BorderBrush>
                                            <TextBlock Text="{Binding LastErrorText}" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource StatusGreen}"/></Border></Grid>
                                    <!-- CPU / RAM / Disk mini gösterge çubukları -->
                                    <StackPanel Margin="0,6,0,0">
                                        <Grid><TextBlock Text="İşlemci Kullanımı" Style="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding CpuText}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11.5"><TextBlock.Foreground><SolidColorBrush Color="{Binding CpuColor}"/></TextBlock.Foreground></TextBlock></Grid>
                                        <ProgressBar Style="{StaticResource MeterBar}" Value="{Binding CpuPercent}" Margin="0,4,0,0"><ProgressBar.Foreground><SolidColorBrush Color="{Binding CpuColor}"/></ProgressBar.Foreground></ProgressBar>
                                    </StackPanel>
                                    <StackPanel Margin="0,7,0,0">
                                        <Grid><TextBlock Text="Bellek Kullanımı" Style="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding MemoryText}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11.5"><TextBlock.Foreground><SolidColorBrush Color="{Binding MemoryColor}"/></TextBlock.Foreground></TextBlock></Grid>
                                        <ProgressBar Style="{StaticResource MeterBar}" Value="{Binding MemoryPercent}" Margin="0,4,0,0"><ProgressBar.Foreground><SolidColorBrush Color="{Binding MemoryColor}"/></ProgressBar.Foreground></ProgressBar>
                                    </StackPanel>
                                    <StackPanel Margin="0,7,0,0">
                                        <Grid><TextBlock Text="Disk Kullanımı" Style="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11.5"><Run Text="%"/><Run Text="{Binding DiskUsedPercent, Mode=OneWay}"/><TextBlock.Foreground><SolidColorBrush Color="{Binding DiskColor}"/></TextBlock.Foreground></TextBlock></Grid>
                                        <ProgressBar Style="{StaticResource MeterBar}" Value="{Binding DiskUsedPercent}" Margin="0,4,0,0"><ProgressBar.Foreground><SolidColorBrush Color="{Binding DiskColor}"/></ProgressBar.Foreground></ProgressBar>
                                    </StackPanel>
                                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Boş Disk Alanı:" Style="{StaticResource Muted}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DiskText}" FontWeight="SemiBold" Foreground="{StaticResource StatusGreen}"/></Grid>
                                </StackPanel>
                            </Border>

                            <!-- Yayın Kuşakları -->
                            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,8,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <iconPacks:PackIconLucide Style="{StaticResource CardHeaderIcon}" Kind="Clock"/>
                                        <TextBlock Style="{StaticResource CardTitleInline}" Text="YAYIN KUŞAKLARI"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Slots}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3.5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Muted}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource FgPrimary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                    <Border Grid.Column="2" CornerRadius="6" Padding="7,2" VerticalAlignment="Center" Background="#0C1726" BorderThickness="1">
                                                        <Border.BorderBrush><SolidColorBrush Color="{Binding StatusColor}" Opacity="0.4"/></Border.BorderBrush>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center"><Ellipse.Fill><SolidColorBrush Color="{Binding StatusColor}"/></Ellipse.Fill></Ellipse>
                                                            <TextBlock Text="{Binding StatusText}" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center">
                                                                <TextBlock.Foreground><SolidColorBrush Color="{Binding StatusColor}"/></TextBlock.Foreground>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Tümünü Yenile" Style="{StaticResource GhostButton}" Margin="0,12,0,0"
                                            Command="{Binding RefreshListCommand}" />
                                </StackPanel>
                            </Border>

                            <!-- Yayın Hazırlık Durumu -->
                            <Border Grid.Column="3" Style="{StaticResource Card}" Margin="8,0,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <iconPacks:PackIconLucide Style="{StaticResource CardHeaderIcon}" Kind="ShieldCheck"/>
                                        <TextBlock Style="{StaticResource CardTitleInline}" Text="YAYIN HAZIRLIK DURUMU"/>
                                    </StackPanel>
                                    <ctl:DonutProgress Height="130" Width="130" HorizontalAlignment="Center" Margin="0,6,0,0" Percent="{Binding ReadinessPercent}" SubText="{Binding ReadinessLabel}">
                                        <ctl:DonutProgress.RingColor><SolidColorBrush Color="{Binding ReadinessColor}"/></ctl:DonutProgress.RingColor>
                                    </ctl:DonutProgress>
                                    <TextBlock Text="Tüm yayın dosyaları yayına hazır." Style="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    <TextBlock TextAlignment="Center" Margin="0,8,0,0">
                                        <Run Text="Son kontrol: " Foreground="{StaticResource FgDim}" FontSize="11.5"/>
                                        <Run Text="{Binding LastCheckTime}" Foreground="{StaticResource FgMuted}" FontSize="11.5" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <Button Content="Detayları Görüntüle" Style="{StaticResource GhostButton}" Margin="0,12,0,0"
                                            Command="{Binding NavigateCommand}" CommandParameter="kusak"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Orta sıra -->
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="1.15*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Son İndirilen Dosyalar -->
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <iconPacks:PackIconLucide Style="{StaticResource CardHeaderIcon}" Kind="FileText"/>
                                        <TextBlock Style="{StaticResource CardTitleInline}" Text="SON İNDİRİLEN DOSYALAR"/>
                                    </StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.2*"/><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="1.05*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Dosya Adı" Style="{StaticResource Muted}" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="Kuşak" Style="{StaticResource Muted}" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="Boyut" Style="{StaticResource Muted}" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="Tarih" Style="{StaticResource Muted}" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="4" Text="Durum" Style="{StaticResource Muted}" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <Grid MinHeight="120">
                                    <ItemsControl ItemsSource="{Binding RecentDownloads}" MaxHeight="150" VerticalAlignment="Top">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2.2*"/><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="1.05*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <iconPacks:PackIconLucide Kind="{Binding Icon, Converter={StaticResource LucideKind}}" Width="13" Height="13" Foreground="{StaticResource FgMuted}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                        <TextBlock Text="{Binding FileName}" Foreground="{StaticResource FgPrimary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Slot}" Style="{StaticResource Muted}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource Muted}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Date}" Style="{StaticResource Muted}"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding StatusText}" Foreground="{StaticResource StatusGreen}" FontSize="12" FontWeight="SemiBold"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,12">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RecentDownloads.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <iconPacks:PackIconLucide Kind="Inbox" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{StaticResource FgDim}" Opacity="0.7"/>
                                            <TextBlock Text="Henüz dosya indirilmedi" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            <TextBlock Text="İlk senkronizasyonda dosyalar burada listelenir." Foreground="{StaticResource FgDim}" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Button Style="{StaticResource GhostButton}" Margin="0,12,0,0" HorizontalAlignment="Left"
                                            Command="{Binding NavigateCommand}" CommandParameter="indirilen">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="FolderOpen" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Tüm Dosyaları Görüntüle" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- İndirme Durumu -->
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,8,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <iconPacks:PackIconLucide Style="{StaticResource CardHeaderIcon}" Kind="Download"/>
                                        <TextBlock Style="{StaticResource CardTitleInline}" Text="İNDİRME DURUMU"/>
                                    </StackPanel>
                                    <ctl:DonutProgress Height="124" Width="124" HorizontalAlignment="Center" Margin="0,6,0,0" Percent="{Binding DownloadPercent}" SubText="Tamamlandı">
                                        <ctl:DonutProgress.RingColor><SolidColorBrush Color="#10B981"/></ctl:DonutProgress.RingColor>
                                    </ctl:DonutProgress>
                                    <StackPanel Margin="0,10,0,0">
                                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Toplam Dosya:" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding TotalFilesText}" Style="{StaticResource ValueText}"/></Grid>
                                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="İndirilen:" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding DownloadedFilesText}" Style="{StaticResource ValueText}"/></Grid>
                                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Kalan:" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding RemainingFilesText}" Style="{StaticResource ValueText}"/></Grid>
                                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Toplam Boyut:" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding TotalSizeText}" Style="{StaticResource ValueText}"/></Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Yayın Hazırlık Kontrolü -->
                            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <iconPacks:PackIconLucide Style="{StaticResource CardHeaderIcon}" Kind="ShieldCheck"/>
                                        <TextBlock Style="{StaticResource CardTitleInline}" Text="YAYIN HAZIRLIK KONTROLÜ"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Checks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Border Width="19" Height="19" CornerRadius="10" Margin="0,0,9,0" VerticalAlignment="Center" BorderThickness="1">
                                                        <Border.Background><SolidColorBrush Color="{Binding Color}" Opacity="0.16"/></Border.Background>
                                                        <Border.BorderBrush><SolidColorBrush Color="{Binding Color}" Opacity="0.5"/></Border.BorderBrush>
                                                        <iconPacks:PackIconLucide Kind="Check" Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center"><iconPacks:PackIconLucide.Foreground><SolidColorBrush Color="{Binding Color}"/></iconPacks:PackIconLucide.Foreground></iconPacks:PackIconLucide>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{StaticResource FgPrimary}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                    <Border Grid.Column="2" CornerRadius="6" Padding="7,2" VerticalAlignment="Center" BorderThickness="1">
                                                        <Border.Background><SolidColorBrush Color="{Binding Color}" Opacity="0.12"/></Border.Background>
                                                        <Border.BorderBrush><SolidColorBrush Color="{Binding Color}" Opacity="0.4"/></Border.BorderBrush>
                                                        <TextBlock Text="{Binding Mark}" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"><TextBlock.Foreground><SolidColorBrush Color="{Binding Color}"/></TextBlock.Foreground></TextBlock>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="{Binding ReadyToAirText}" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                                            Background="{StaticResource StatusGreen}" FontWeight="Bold"
                                            Command="{Binding SyncNowCommand}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                </Grid>

                <!-- ============ DİĞER BÖLÜMLER (alanı doldurur, scroll yok) ============ -->
                <Grid Margin="24,12,24,16">
                    <Border Style="{StaticResource Card}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionToVis}, ConverterParameter=indirilen}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Başlık + dosya sayısı -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Style="{StaticResource CardHeaderIcon}" Kind="Download"/>
                                    <TextBlock Style="{StaticResource CardTitleInline}" Text="İNDİRİLEN DOSYALAR"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" CornerRadius="8" Padding="12,5" Background="#16202F" BorderBrush="#243149" BorderThickness="1" VerticalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center"><Run Text="{Binding RecentDownloads.Count, Mode=OneWay}" Foreground="{StaticResource FgPrimary}" FontWeight="Bold" FontSize="13"/><Run Text=" dosya" Foreground="{StaticResource FgMuted}" FontSize="11.5"/></TextBlock>
                                </Border>
                            </Grid>

                            <!-- Sütun başlıkları -->
                            <Grid Grid.Row="1" Margin="2,0,2,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Dosya Adı" Style="{StaticResource Muted}" FontSize="10.5" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Boyut" Style="{StaticResource Muted}" FontSize="10.5" FontWeight="Bold"/>
                                <TextBlock Grid.Column="2" Text="Tarih" Style="{StaticResource Muted}" FontSize="10.5" FontWeight="Bold"/>
                                <TextBlock Grid.Column="3" Text="Durum" Style="{StaticResource Muted}" FontSize="10.5" FontWeight="Bold"/>
                            </Grid>
                            <Border Grid.Row="2" Background="{StaticResource BorderColor}" Height="1"/>

                            <!-- Liste + boş durum -->
                            <Grid Grid.Row="3">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding RecentDownloads}" VerticalAlignment="Top" Margin="2,4,2,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderThickness="0,0,0,1" BorderBrush="#141E30" Padding="0,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <iconPacks:PackIconLucide Kind="{Binding Icon, Converter={StaticResource LucideKind}}" Width="14" Height="14" Foreground="{StaticResource FgMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding FileName}" Foreground="{StaticResource FgPrimary}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Size}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Date}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="3" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#0C1726" BorderBrush="#1B5E3A" BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="6" Height="6" Fill="{StaticResource StatusGreen}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource StatusGreen}" FontSize="10.5" FontWeight="Bold"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <!-- Boş durum -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RecentDownloads.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border Width="66" Height="66" CornerRadius="33" HorizontalAlignment="Center" Background="#13203A" BorderBrush="#243149" BorderThickness="1">
                                        <iconPacks:PackIconLucide Kind="Inbox" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource FgMuted}"/>
                                    </Border>
                                    <TextBlock Text="Henüz dosya indirilmedi" Foreground="{StaticResource FgPrimary}" FontWeight="SemiBold" FontSize="13.5" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                                    <TextBlock Text="İlk senkronizasyonda indirilen dosyalar burada listelenir." Style="{StaticResource Muted}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionToVis}, ConverterParameter=kusak}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Başlık + hazır chip -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Yayın Kuşakları" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="Günlük yayın planı — her kuşağın hazırlık durumu" Style="{StaticResource Muted}"/>
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="8" Padding="13,6" Background="#16202F" BorderBrush="#243149" BorderThickness="1" VerticalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center"><Run Text="{Binding ReportSlotsReady}" Foreground="{StaticResource FgPrimary}" FontWeight="Bold" FontSize="13"/><Run Text=" hazır" Foreground="{StaticResource FgMuted}" FontSize="11.5"/></TextBlock>
                                </Border>
                            </Grid>

                            <!-- Plan listesi — alanı eşit satırlarla doldurur -->
                            <Border Grid.Row="1" CornerRadius="12" BorderThickness="1" Padding="6,4">
                                <Border.Background><SolidColorBrush Color="#0C1322"/></Border.Background>
                                <Border.BorderBrush><SolidColorBrush Color="#1E293B"/></Border.BorderBrush>
                                <ItemsControl ItemsSource="{Binding Slots}" VerticalAlignment="Stretch">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="1"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="9" Padding="12,0" Margin="2,1" BorderThickness="0,0,0,1" BorderBrush="#141E30">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#131E33"/></Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" CornerRadius="6" Width="62" Height="28" Background="#11192B" BorderBrush="#243149" BorderThickness="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Time}" FontFamily="Consolas" Foreground="{StaticResource FgPrimary}" FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource FgPrimary}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                                    <Border Grid.Column="2" CornerRadius="7" Padding="11,4" VerticalAlignment="Center" Background="#16202F">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"><Ellipse.Fill><SolidColorBrush Color="{Binding StatusColor}"/></Ellipse.Fill></Ellipse>
                                                            <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="10.5"><TextBlock.Foreground><SolidColorBrush Color="{Binding StatusColor}"/></TextBlock.Foreground></TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Özet bandı (alta) -->
                            <Border Grid.Row="2" CornerRadius="12" Padding="18,13" BorderThickness="1" Margin="0,14,0,0">
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#15233B" Offset="0"/><GradientStop Color="#0E1626" Offset="1"/></LinearGradientBrush></Border.Background>
                                <Border.BorderBrush><SolidColorBrush Color="#243149"/></Border.BorderBrush>
                                <UniformGrid Columns="4">
                                    <StackPanel><TextBlock Text="TOPLAM KUŞAK" Foreground="{StaticResource FgMuted}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="7" Foreground="{StaticResource FgPrimary}" FontSize="18" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel>
                                    <StackPanel><TextBlock Text="HAZIR" Foreground="{StaticResource FgMuted}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="{Binding ReportSlotsReady}" Foreground="{StaticResource StatusGreen}" FontSize="18" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel>
                                    <StackPanel><TextBlock Text="SON KONTROL" Foreground="{StaticResource FgMuted}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="{Binding LastCheckTime}" Foreground="{StaticResource FgPrimary}" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                                    <StackPanel><TextBlock Text="SON SENKRONİZASYON" Foreground="{StaticResource FgMuted}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="{Binding LastSyncTime}" Foreground="{StaticResource FgPrimary}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                                </UniformGrid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionToVis}, ConverterParameter=liste}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Başlık + hazır chip -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Yayın Listesi" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="Sunucudan alınan güncel yayın kuşağı planı." Style="{StaticResource Muted}"/>
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="8" Padding="13,6" Background="#16202F" BorderBrush="#243149" BorderThickness="1" VerticalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center"><Run Text="{Binding ReportSlotsReady}" Foreground="{StaticResource FgPrimary}" FontWeight="Bold" FontSize="13"/><Run Text=" hazır" Foreground="{StaticResource FgMuted}" FontSize="11.5"/></TextBlock>
                                </Border>
                            </Grid>

                            <!-- Plan listesi — alanı eşit satırlarla doldurur -->
                            <Border Grid.Row="1" CornerRadius="12" BorderThickness="1" Padding="6,4">
                                <Border.Background><SolidColorBrush Color="#0C1322"/></Border.Background>
                                <Border.BorderBrush><SolidColorBrush Color="#1E293B"/></Border.BorderBrush>
                                <ItemsControl ItemsSource="{Binding Slots}" VerticalAlignment="Stretch">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="1"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="9" Padding="12,0" Margin="2,1" BorderThickness="0,0,0,1" BorderBrush="#141E30">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#131E33"/></Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" CornerRadius="6" Width="62" Height="28" Background="#11192B" BorderBrush="#243149" BorderThickness="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Time}" FontFamily="Consolas" Foreground="{StaticResource FgPrimary}" FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource FgPrimary}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                                    <Border Grid.Column="2" CornerRadius="7" Padding="11,4" VerticalAlignment="Center" Background="#16202F">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"><Ellipse.Fill><SolidColorBrush Color="{Binding StatusColor}"/></Ellipse.Fill></Ellipse>
                                                            <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="10.5"><TextBlock.Foreground><SolidColorBrush Color="{Binding StatusColor}"/></TextBlock.Foreground></TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Özet bandı (alta) -->
                            <Border Grid.Row="2" CornerRadius="12" Padding="18,13" BorderThickness="1" Margin="0,14,0,0">
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#15233B" Offset="0"/><GradientStop Color="#0E1626" Offset="1"/></LinearGradientBrush></Border.Background>
                                <Border.BorderBrush><SolidColorBrush Color="#243149"/></Border.BorderBrush>
                                <UniformGrid Columns="4">
                                    <StackPanel><TextBlock Text="TOPLAM KUŞAK" Foreground="{StaticResource FgMuted}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="7" Foreground="{StaticResource FgPrimary}" FontSize="18" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel>
                                    <StackPanel><TextBlock Text="HAZIR" Foreground="{StaticResource FgMuted}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="{Binding ReportSlotsReady}" Foreground="{StaticResource StatusGreen}" FontSize="18" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel>
                                    <StackPanel><TextBlock Text="SON KONTROL" Foreground="{StaticResource FgMuted}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="{Binding LastCheckTime}" Foreground="{StaticResource FgPrimary}" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                                    <StackPanel><TextBlock Text="SON SENKRONİZASYON" Foreground="{StaticResource FgMuted}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="{Binding LastSyncTime}" Foreground="{StaticResource FgPrimary}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                                </UniformGrid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{Binding SelectedSection, Converter={StaticResource SectionToVis}, ConverterParameter=servis}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="Activity" Width="17" Height="17" Foreground="{StaticResource StatusGreen}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <TextBlock Text="Servis Durumu — Sistem İzleme" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#10331F" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource StatusGreen}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="CANLI" Foreground="{StaticResource StatusGreen}" FontWeight="Bold" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Kaynak gauge'lari: CPU / RAM / Disk — premium metrik panelleri -->
                            <UniformGrid Grid.Row="1" Columns="3" Margin="0,8,0,2">
                                <!-- CPU -->
                                <Border CornerRadius="14" Padding="15,13" Margin="0,0,10,0" BorderThickness="1" BorderBrush="#1E2D44">
                                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1"><GradientStop Color="#13212F" Offset="0"/><GradientStop Color="#0A111D" Offset="1"/></LinearGradientBrush></Border.Background>
                                    <Border.Effect><DropShadowEffect Color="#000814" BlurRadius="16" ShadowDepth="0" Opacity="0.40"/></Border.Effect>
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="22" Height="22" CornerRadius="6" Background="#11283C" Margin="0,0,8,0"><iconPacks:PackIconLucide Kind="Cpu" Width="12" Height="12" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                <TextBlock Text="İŞLEMCİ (CPU)" Style="{StaticResource Muted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Polyline HorizontalAlignment="Right" VerticalAlignment="Center" Points="0,8 4,8 6,3 9,11 12,5 15,8 26,8" Stroke="#38BDF8" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                                        </Grid>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <ctl:DonutProgress Height="92" Width="92" VerticalAlignment="Center" Percent="{Binding CpuPercent}" SubText="kullanım">
                                                <ctl:DonutProgress.RingColor><SolidColorBrush Color="{Binding CpuColor}"/></ctl:DonutProgress.RingColor>
                                            </ctl:DonutProgress>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                                <TextBlock Text="CPU Kullanımı" Style="{StaticResource Muted}" FontSize="11"/>
                                                <TextBlock Text="{Binding CpuText}" FontSize="25" FontWeight="Bold" Margin="0,1,0,4"><TextBlock.Foreground><SolidColorBrush Color="{Binding CpuColor}"/></TextBlock.Foreground></TextBlock>
                                                <Border CornerRadius="6" Padding="7,2" HorizontalAlignment="Left" Background="#0C1726" BorderThickness="1">
                                                    <Border.BorderBrush><SolidColorBrush Color="{Binding CpuColor}" Opacity="0.4"/></Border.BorderBrush>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center"><Ellipse.Fill><SolidColorBrush Color="{Binding CpuColor}"/></Ellipse.Fill></Ellipse>
                                                        <TextBlock Text="{Binding CpuLevelText}" FontSize="10.5" FontWeight="Bold"><TextBlock.Foreground><SolidColorBrush Color="{Binding CpuColor}"/></TextBlock.Foreground></TextBlock>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="{Binding CpuLevelDetail}" Foreground="{StaticResource FgDim}" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <!-- RAM -->
                                <Border CornerRadius="14" Padding="15,13" Margin="0,0,10,0" BorderThickness="1" BorderBrush="#262145">
                                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1"><GradientStop Color="#1A1730" Offset="0"/><GradientStop Color="#0B0A18" Offset="1"/></LinearGradientBrush></Border.Background>
                                    <Border.Effect><DropShadowEffect Color="#000814" BlurRadius="16" ShadowDepth="0" Opacity="0.40"/></Border.Effect>
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="22" Height="22" CornerRadius="6" Background="#241F3C" Margin="0,0,8,0"><iconPacks:PackIconLucide Kind="MemoryStick" Width="12" Height="12" Foreground="#A78BFA" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                <TextBlock Text="BELLEK (RAM)" Style="{StaticResource Muted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Polyline HorizontalAlignment="Right" VerticalAlignment="Center" Points="0,8 4,8 6,3 9,11 12,5 15,8 26,8" Stroke="#A78BFA" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                                        </Grid>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <ctl:DonutProgress Height="92" Width="92" VerticalAlignment="Center" Percent="{Binding MemoryPercent}" SubText="kullanım">
                                                <ctl:DonutProgress.RingColor><SolidColorBrush Color="{Binding MemoryColor}"/></ctl:DonutProgress.RingColor>
                                            </ctl:DonutProgress>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                                <TextBlock Text="Bellek Kullanımı" Style="{StaticResource Muted}" FontSize="11"/>
