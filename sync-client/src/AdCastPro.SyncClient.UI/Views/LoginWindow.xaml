<Window
    x:Class="AdCastPro.SyncClient.UI.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Title="AdCast Pro Sync — Giriş"
    Icon="/AdCastPro.SyncClient;component/Assets/app.ico"
    Width="440"
    Height="568"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize">
    <Border
        Background="{StaticResource BgDark}"
        BorderBrush="{StaticResource BorderColor}"
        BorderThickness="1"
        CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Baslik cubugu: surukle + kapat -->
            <Grid Grid.Row="0" Height="44" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource BrandRed}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="AdCast Pro" Foreground="{StaticResource FgMuted}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="✕" Click="OnClose" ToolTip="Kapat"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="44" Height="44" Style="{StaticResource WindowCloseButton}" />
            </Grid>

            <!-- Icerik -->
            <Grid Grid.Row="1" Margin="36,2,36,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Marka -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Image Source="/AdCastPro.SyncClient;component/Assets/adcastpro-logo.png"
                           Stretch="Uniform" Width="280" MaxHeight="100"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock
                        FontFamily="{StaticResource UiFont}"
                        FontSize="12.5"
                        Foreground="{StaticResource FgMuted}"
                        HorizontalAlignment="Center"
                        Margin="0,2,0,0"
                        Text="Yayın Senkronizasyon İstemcisi" />
                </StackPanel>

                <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource BorderColor}" Margin="0,6,0,22" />

                <!-- Form -->
                <StackPanel Grid.Row="2" VerticalAlignment="Center">
                    <TextBlock Text="Kullanıcı Adı" Foreground="{StaticResource FgMuted}" FontSize="12.5" Margin="0,0,0,6" />
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="9" Height="44" Margin="0,0,0,16">
                        <TextBox
                            x:Name="UsernameBox"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="{StaticResource FgPrimary}"
                            CaretBrush="{StaticResource FgPrimary}"
                            FontSize="14"
                            Padding="12,0"
                            VerticalContentAlignment="Center"
                            Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>

                    <TextBlock Text="Şifre" Foreground="{StaticResource FgMuted}" FontSize="12.5" Margin="0,0,0,6" />
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="9" Height="44" Margin="0,0,0,8">
                        <PasswordBox
                            x:Name="PasswordBox"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="{StaticResource FgPrimary}"
                            CaretBrush="{StaticResource FgPrimary}"
                            FontSize="14"
                            Padding="12,0"
                            VerticalContentAlignment="Center"
                            PasswordChanged="OnPasswordChanged" />
                    </Border>

                    <TextBlock
                        x:Name="ErrorText"
                        Text="{Binding ErrorMessage}"
                        Foreground="{StaticResource StatusRed}"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Margin="0,4,0,8" />

                    <Button
                        Height="46"
                        Content="Giriş Yap"
                        FontSize="14.5"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoginCommand}" />
                </StackPanel>

                <!-- Alt bilgi -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <iconPacks:PackIconLucide Kind="Lock" Width="11" Height="11" Foreground="{StaticResource FgMuted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock
                        Text="Oturum güvenli şekilde DPAPI ile saklanır."
                        FontSize="11"
                        Foreground="{StaticResource FgMuted}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
