<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AdCastPro.SyncClient</AssemblyName>
    <RootNamespace>AdCastPro.SyncClient.UI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Logo + ikon — pencere/gorev cubugu/tray + sidebar gorseli icin Resource. -->
    <Resource Include="Assets\adcastpro-logo.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- App projesindeki appsettings.json'u UI exe ciktisina kopyala (tek kaynak). -->
    <Content Include="..\AdCastPro.SyncClient.App\appsettings.json" Link="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AdCastPro.SyncClient.Core\AdCastPro.SyncClient.Core.csproj" />
    <ProjectReference Include="..\AdCastPro.SyncClient.Infrastructure\AdCastPro.SyncClient.Infrastructure.csproj" />
    <ProjectReference Include="..\AdCastPro.SyncClient.App\AdCastPro.SyncClient.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MahApps.Metro.IconPacks.Lucide" Version="6.2.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>
</Project>
