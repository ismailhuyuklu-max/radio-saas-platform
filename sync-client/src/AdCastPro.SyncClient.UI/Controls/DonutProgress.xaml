<UserControl
    x:Class="AdCastPro.SyncClient.UI.Controls.DonutProgress"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="OnSizeChanged">
    <Grid>
        <Ellipse x:Name="Track" Stroke="{StaticResource TrackColor}" StrokeThickness="14" Margin="9" />
        <Path x:Name="Arc" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="BigText" Text="%0" FontFamily="Segoe UI" FontSize="30" FontWeight="Bold"
                       Foreground="{StaticResource FgPrimary}" HorizontalAlignment="Center" />
            <TextBlock x:Name="SubTextBlock" Text="" FontFamily="Segoe UI" FontSize="11.5" FontWeight="SemiBold"
                       Foreground="{StaticResource FgMuted}" HorizontalAlignment="Center" Margin="0,2,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
