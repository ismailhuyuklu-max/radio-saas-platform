<UserControl
    x:Class="AdCastPro.SyncClient.UI.Controls.DonutProgress"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="OnSizeChanged">
    <Grid>
        <Ellipse Stroke="#0A1322" StrokeThickness="3" Margin="2" Opacity="0.9" />
        <Ellipse Stroke="#16243A" StrokeThickness="1" Margin="4" Opacity="0.7" />
        <!-- Segmentli dial: arka plan tickleri (koyu) + dolu tickler (renkli, glow) -->
        <Canvas x:Name="TickBg" />
        <Canvas x:Name="TickFg">
            <Canvas.Effect>
                <DropShadowEffect x:Name="TickGlow" Color="#19C37D" BlurRadius="12" ShadowDepth="0" Opacity="0.75" />
            </Canvas.Effect>
        </Canvas>
        <!-- Smooth arc (segmentlerin üstünde ince vurgu) -->
        <Path x:Name="Arc" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.9" />
        <Ellipse Stroke="#1E3150" StrokeThickness="1" Margin="30" Opacity="0.45" />
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="BigText" Text="%0" FontFamily="Segoe UI" FontSize="30" FontWeight="Bold"
                       Foreground="{StaticResource FgPrimary}" HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="0" Opacity="0.7" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="SubTextBlock" Text="" FontFamily="Segoe UI" FontSize="11.5" FontWeight="Bold"
                       Foreground="{StaticResource StatusGreen}" HorizontalAlignment="Center" Margin="0,2,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
